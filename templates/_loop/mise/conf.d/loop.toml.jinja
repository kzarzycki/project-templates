{% set toolchain = language | default('') if project_type == 'ai/mcp' else project_type %}
[tasks."ci:narrowed"]
description = "Says in CI's step output whether a PR or a push runs the narrowed check: loop.md names an `Affected tests:` command and not `Gate: full`, as the pack reads it."
# The pack's own reader (gatekeeper.py narrowing) judges the text, so the grammar is the pack's. It runs under
# uv with the dependencies the pack declares in its script header (it imports PyYAML, which a bare python3 may lack).
# A PR reads loop.md from its base (HEAD^1, the first parent of the merge commit CI checks out), so a PR cannot loosen
# its own gate; a push to main reads the working tree. A file the base lacks or an event that never narrows is
# not narrowed and says nothing; a pack that cannot answer is not narrowed either, with a warning that names why.
run = '''
narrowed=false
case "${GITHUB_EVENT_NAME:-}" in
  pull_request) loop="$(git show HEAD^1:docs/agents/loop.md 2>/dev/null)" || loop="" ;;
  push) loop="$(cat docs/agents/loop.md 2>/dev/null)" || loop="" ;;
  *) loop="" ;;
esac
scripts=.agents/skills/gatekeeper/scripts
if [ -n "$loop" ]; then
  probe="$(mktemp -d)/probe.py"
  { sed -n '/^# \/\/\/ script$/,/^# \/\/\/$/p' "$scripts/gatekeeper.py" 2>/dev/null
    cat <<'PY'
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, sys.argv[1])
import gatekeeper
print("narrowed" if gatekeeper.narrowing(sys.stdin.read()) else "full")
PY
  } > "$probe"
  if answer="$(printf '%s\n' "$loop" | uv run -q --script "$probe" "$PWD/$scripts" 2>"$probe.err")"; then
    [ "$answer" = narrowed ] && narrowed=true
  else
    echo "::warning::ci:narrowed ran the full check: the pack's loop.md reader failed: $(tail -n 3 "$probe.err" | tr '\n' ' ')" >&2
  fi
fi
echo "narrowed=$narrowed"
if [ -n "${GITHUB_OUTPUT:-}" ]; then echo "narrowed=$narrowed" >> "$GITHUB_OUTPUT"; fi
'''

[tasks."ci:last-green"]
description = "Prints the head commit of the newest earlier scheduled run of this workflow that passed, else the repository's first commit; for the nightly's red report."
# A failed lookup (an API error, a rate limit) fails the task: reading it as "no green run yet" would list every merge ever made.
run = '''
workflow="${GITHUB_WORKFLOW_REF%%@*}"; workflow="${workflow##*/}"
found="$(gh api "repos/$GITHUB_REPOSITORY/actions/workflows/$workflow/runs?event=schedule&status=success&per_page=1" --jq '.workflow_runs[0].head_sha // empty')" \
  || { echo "::error::could not list this workflow's scheduled runs" >&2; exit 1; }
[ -n "$found" ] || found="$(git rev-list --max-parents=0 "${GITHUB_SHA:-HEAD}" | tail -n 1)"
echo "$found"
if [ -n "${GITHUB_OUTPUT:-}" ]; then echo "sha=$found" >> "$GITHUB_OUTPUT"; fi
'''

[tasks."loop:approvals"]
alias = "gate"
description = "Checks the loop's proofs on GitHub: approved spec, verdict, Evidence, merge approval. merge exits 3 while it waits for check, or for the owner's approved:merge on a high-risk PR."
usage = '''
arg "<point>" help="build or merge"
arg "[pr]" help="the PR number; default: this branch's PR"
'''
# Add the project's own checks as more lines; the task stops at the first that fails.
# ponytail: the path is the codex target's copy; without codex, point it at .claude/skills.
run = [
  'test -f .agents/skills/gatekeeper/scripts/gatekeeper.py || { echo "loop:approvals: the gatekeeper skill is not installed; run mise run agent:sync and commit its output" >&2; exit 1; }',
  'uv run .agents/skills/gatekeeper/scripts/gatekeeper.py check "${usage_point}" ${usage_pr:-}',
]

[tasks."loop:land"]
description = "The one way an agent lands PRs: under a lock, the pack's batch land gates every landable PR, this one included, as one batch on their combined tree, then merges each through GitHub pinned to its head. Exits 0 merged, 1 on a missing proof, 3 while it waits (a pending check, or the lock held by another land); with --wait it returns only once the PR merges or needs someone. Where main requires GitHub's merge queue it enqueues each landable PR instead, pinned to its head, and the queue's CI run gates it."
usage = '''
arg "<pr>" help="the PR number"
flag "--wait" help="wait until the PR merges or needs someone"
'''
# ponytail: the path is the codex target's copy; without codex, point it at .claude/skills.
run = [
  'test -f .agents/skills/gatekeeper/scripts/gatekeeper.py || { echo "loop:land: the gatekeeper skill is not installed; run mise run agent:sync and commit its output" >&2; exit 1; }',
  'uv run .agents/skills/gatekeeper/scripts/gatekeeper.py land "${usage_pr}" $([ "${usage_wait:-false}" = true ] && echo --wait)',
]

[tasks."ci:approvals"]
description = "CI's approvals step: posts loop:approvals merge's result as the loop:approvals and gatekeeper commit statuses (same state, description and link) on the PR head (pending while it waits){% if merge_queue %}; success on a merge-queue commit{% endif %}; a push removes approved:merge first. It never merges: mise run loop:land does."
# A job ends only as success or failure, and GitHub counts a skipped job as passed, so the
# result is a commit status, which main's ruleset requires. It is posted as `loop:approvals` (what rulesets
# require) and as `gatekeeper` (the gatekeeper's new name, posted for one release line). The workflow sets {% if merge_queue %}EVENT, {% endif %}ACTION,
# PR, {% if merge_queue %}QUEUE_HEAD {% endif %}and RUN_URL.
run = '''
post() {
  for context in loop:approvals gatekeeper; do
    gh api -X POST "repos/$GITHUB_REPOSITORY/statuses/$1" -f state="$2" -f context="$context" \
      -f description="$(printf '%s' "$3" | cut -c1-140)" -f target_url="$RUN_URL" >/dev/null
  done
  echo "loop:approvals, gatekeeper: $2 on $1: $3"
}
{% if merge_queue %}if [ "$EVENT" = merge_group ]; then
  # A PR is queued only with the status green on its head, so the queue's commit passes.
  post "$QUEUE_HEAD" success "checked on the PR before it was queued"
  exit 0
fi
{% endif %}[ -n "${PR:-}" ] || { echo "ci:approvals: no PR for this run; nothing to post"; exit 0; }
pull="$(gh pr view "$PR" --json headRefOid,isDraft,author --jq '[.headRefOid, .isDraft, .author.login] | @tsv')"
head="$(printf '%s' "$pull" | cut -f1)"
if [ "$(printf '%s' "$pull" | cut -f2)" = true ]; then echo "ci:approvals: PR #$PR is a draft; nothing to post"; exit 0; fi
if [ "$(printf '%s' "$pull" | cut -f3)" = "app/dependabot" ]; then
  post "$head" success "a dependabot update carries no loop proofs"
  exit 0
fi
if [ "$ACTION" = synchronize ]; then
  # The label never covers a head the owner didn't see. A 404 means it was not on the PR.
  out="$(gh api -X DELETE "repos/$GITHUB_REPOSITORY/issues/$PR/labels/approved:merge" 2>&1)" || case "$out" in
    *"HTTP 404"*) ;;
    *) post "$head" failure "could not remove approved:merge after the push"; echo "ci:approvals: could not remove approved:merge: $out" >&2; exit 1 ;;
  esac
fi
code=0
out="$(mise run --quiet --skip-tools loop:approvals merge "$PR")" || code=$?
printf '%s\n' "$out"
first="$(printf '%s\n' "$out" | sed -n 1p)"
case "$code" in
  0) post "$head" success "${first:-every proof holds}" ;;
  3) post "$head" pending "$first" ;;
  *) post "$head" failure "${first:-loop:approvals exited $code}"; exit 1 ;;
esac
# The job never merges: mise run loop:land gates every landable PR as one batch under a lock and merges
# each with the agent's own token, so main's push workflows run on every merge.
'''

[tasks."setup:github"]
description = "Writes GitHub settings (the ruleset and head branch deletion; on a plan without rulesets, squash-only merges and head branch deletion), then syncs the labels with the pack's labels.py, from the repo's files; runs no checks. --dry-run prints the label plan and writes nothing; --revert deletes the ruleset."
usage = '''
flag "--revert" help="Delete the loop-merge-queue ruleset; the repository settings are restored with the command apply printed"
flag "--dry-run" help="Print what labels.py would change; write nothing to GitHub (no ruleset, settings or labels)"
'''
# The task owns only the ruleset named loop-merge-queue and never reads or changes another one:
# GitHub layers every active ruleset on a branch, so the repo's own rules keep applying.
{% if include_ci %}# The ruleset requires CI's `check` job and the `loop:approvals` status by name: rename one, update
# the ruleset, rerun this.
{% else %}# The ruleset requires the `loop:approvals` status by name: rename it, update the ruleset, rerun this.
{% endif %}run = '''
command -v gh >/dev/null || { echo "error: gh is required; install the GitHub CLI and run 'gh auth login'" >&2; exit 127; }
# The labels are the pack's: labels.py is their one definition, read from docs/agents/issue-tracker.md.
# ponytail: the path is the codex target's copy; without codex, point it at .claude/skills.
labels=.agents/skills/github-tracker/scripts/labels.py
# Checked before any write, so a missing skill never leaves the ruleset applied and the labels not.
if [ "${usage_revert:-false}" = true ]; then
  if [ "${usage_dry_run:-false}" = true ]; then echo "error: --dry-run and --revert cannot be combined" >&2; exit 2; fi
elif [ ! -f "$labels" ]; then
  echo "setup:github: the github-tracker skill is not installed; run mise run agent:sync and commit its output" >&2
  exit 1
elif [ "${usage_dry_run:-false}" = true ]; then
  echo "dry run: the ruleset and repository settings are left as they are"
  exec uv run "$labels" --dry-run
fi
# A private repo on GitHub Free has no rulesets: GitHub answers the rules read with this 403,
# the probe the pack's land uses. Any other error stops the task.
free=false
if ! probe="$(gh api 'repos/{owner}/{repo}/rules/branches/main' 2>&1 >/dev/null)"; then
  case "$probe" in *"Upgrade to GitHub Pro"*"(HTTP 403)"*) free=true ;; *) echo "$probe" >&2; exit 1 ;; esac
fi
if [ "$free" = true ] && [ "${usage_revert:-false}" = true ]; then echo "no rulesets on this plan: nothing to revert"; exit 0; fi
if [ "$free" = true ]; then
  # Squash-only merges and head branch deletion are what Free allows; the ruleset is skipped.
  # A standalone assignment, so a failed read stops the task before the PATCH loses the previous values.
  settings="$(gh api 'repos/{owner}/{repo}' --jq '.allow_merge_commit, .allow_rebase_merge, .allow_squash_merge, .delete_branch_on_merge')"
  set -- $settings
  gh api -X PATCH 'repos/{owner}/{repo}' -F allow_merge_commit=false -F allow_rebase_merge=false \
    -F allow_squash_merge=true -F delete_branch_on_merge=true >/dev/null
  echo "allow_merge_commit was $1, allow_rebase_merge was $2, allow_squash_merge was $3, delete_branch_on_merge was $4;" \
    "restore: gh api -X PATCH 'repos/{owner}/{repo}' -F allow_merge_commit=$1 -F allow_rebase_merge=$2 -F allow_squash_merge=$3 -F delete_branch_on_merge=$4"
  echo "GitHub enforces nothing on main here (this plan has no rulesets): no ruleset applied, mise run loop:land is the only gate"
else
  id="$(gh api --paginate 'repos/{owner}/{repo}/rulesets' --jq '.[] | select(.source_type == "Repository" and .name == "loop-merge-queue") | .id')"
  if [ "${usage_revert:-false}" = true ]; then
    if [ -z "$id" ]; then echo "no loop-merge-queue ruleset: nothing to revert"; exit 0; fi
    # A 404 means another run deleted it first: the revert is done either way.
    out="$(gh api -X DELETE "repos/{owner}/{repo}/rulesets/$id" 2>&1)" || case "$out" in *"HTTP 404"*) ;; *) echo "$out" >&2; exit 1 ;; esac
    echo "deleted ruleset loop-merge-queue ($id)"
    exit 0
  fi
  if [ -n "$id" ]; then
    gh api -X PUT "repos/{owner}/{repo}/rulesets/$id" --input .github/rulesets/main.json --jq '"updated ruleset loop-merge-queue (\(.id))"'
  else
    gh api -X POST 'repos/{owner}/{repo}/rulesets' --input .github/rulesets/main.json --jq '"created ruleset loop-merge-queue (\(.id))"'
  fi
  # GitHub deletes the merged head branch. allow_auto_merge is left as it is: loop:land merges directly.
  delete="$(gh api 'repos/{owner}/{repo}' --jq .delete_branch_on_merge)"
  gh api -X PATCH 'repos/{owner}/{repo}' -F delete_branch_on_merge=true >/dev/null
  echo "delete_branch_on_merge was $delete, now true; restore: gh api -X PATCH 'repos/{owner}/{repo}' -F delete_branch_on_merge=$delete"
  echo "revert the ruleset: mise run setup:github --revert"
fi
uv run "$labels"
'''
{% if toolchain in ['software/python', 'python'] %}
[tasks."test:affected"]
description = "The loop's `Affected tests:` command: the whole-repo lints, then the tests the change affects (here every unit test)."
# ponytail: pytest-testmon keeps its selection in a local .testmondata DB, which a fresh checkout lacks, so this runs the whole unit suite; swap in the pack's `affected-tests` selector once kzarzycki/agent-skills#2217 ships.
run = "mise run --skip-tools check:lint && uv run pytest"
{% endif -%}
{% if toolchain in ['software/node', 'node'] %}
[tasks."test:affected"]
description = "The loop's `Affected tests:` command: the whole-repo lints and type check, then the vitest tests affected by the change since GATE_BASE."
# GATE_BASE is the commit the gatekeeper selects against; without it, or before origin/main exists, every test runs.
run = '''
mise run --skip-tools check:lint
base="${GATE_BASE:-origin/main}"
if git rev-parse -q --verify "$base^{commit}" >/dev/null; then npx vitest run --changed "$base"; else npx vitest run; fi
'''
{% endif -%}
{% if toolchain == 'software/java' %}
[tasks."test:affected"]
description = "The loop's `Affected tests:` command: the whole-repo lints, then the tests the change affects (here every unit test)."
# ponytail: Gradle's up-to-date check lives in a local cache, which a fresh checkout lacks, so this runs the whole unit suite; swap in the pack's `affected-tests` selector once kzarzycki/agent-skills#2217 ships.
run = "mise run --skip-tools check:lint && ./gradlew test"
{% endif -%}