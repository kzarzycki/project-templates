[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">={{ python_version }}"
dependencies = [
    "dbt-core>=1.12,<2",
    # Swap for your warehouse adapter, e.g. dbt-postgres, dbt-bigquery, dbt-databricks.
    "dbt-snowflake>=1.12,<2",
]

[dependency-groups]
dev = [
    "sqlfluff>=4.2,<5",
    "sqlfluff-templater-dbt>=4.2,<5",
]

[tool.uv]
package = false
