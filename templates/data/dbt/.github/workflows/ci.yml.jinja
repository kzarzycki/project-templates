{% include "templates/_base/_ci_header.yml.jinja" %}
jobs:
{% if include_mise -%}
{% include "templates/_base/_ci_jobs.yml.jinja" -%}
{% else %}
  build:
    # A draft runs nothing until ready_for_review; a push or a queue entry has no PR, so it always runs.
    if: {% raw %}${{ !github.event.pull_request.draft }}{% endraw %}
    runs-on: ubuntu-latest
    steps:
{% include "templates/_base/_ci_steps.yml.jinja" %}      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: "{{ python_version }}"
      - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
        with:
          enable-cache: true
      - run: uv sync --locked
      - run: uv run dbt deps
      # `dbt parse` validates the project graph without a warehouse connection,
      # so CI stays green on a fresh repo. Wire `dbt build` / `dbt test` below
      # once warehouse credentials are available as repo secrets.
      - run: uv run dbt parse
{% endif -%}
