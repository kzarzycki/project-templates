[tools]
python = "{{ python_version }}"
uv = "0.11.29"
pre-commit = "4.6.0"
{% include "templates/_base/_mise_agent_tasks.part" %}
{% set check_commands %}uv run dbt deps
uv run dbt parse
{% endset -%}
{% include "templates/_base/_mise_check_task.part" %}

[tasks.deps]
run = "uv run dbt deps"

[tasks.build]
run = "uv run dbt build"

[tasks.test]
run = "uv run dbt test"

[tasks.lint]
run = "uv run sqlfluff lint models/"

[tasks.bootstrap]
run = "uv sync && pre-commit install --install-hooks"

[hooks]
postinstall = "pre-commit install --install-hooks"
