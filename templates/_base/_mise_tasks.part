{% set scripts_dir = scripts_dir | default("scripts") -%}
{% if include_agent_layer -%}
[env]
{% if agent_layer_mode == 'vendored' -%}
# APM hash-tracks every file it deploys, so a fix there is drift that `mise run agent:sync` refuses
# over: the fixing lint: tasks skip these trees. The secret scanners still read them.
APM_MANAGED = '^(\.agents|\.claude|\.codex)/'
{% else -%}
# APM owns these trees and hash-tracks every file it deploys, so a fix there is drift that
# fails `mise run check:agents`: the fixing lint: tasks skip them. The secret scanners still read them.
APM_MANAGED = '^(\.agents|\.claude|\.codex|\.github/instructions)/|(^|/)AGENTS\.md$|/CLAUDE\.md$'
{% endif %}
{% endif -%}
{% if include_ci %}# The merge checks: every check: task but check:all is a part, and CI runs each as its own
# job named after it (mise run ci:parts). Add a part here and CI runs it; give it a path
# filter in .github/check-paths.yml.
{% else %}# The merge checks: every check: task but check:all is a part. With no CI (loop.md `ci: false`),
# the merge proof is approvals.py local-ci, which runs them on a clean checkout of the head.
{% endif %}[tasks.check]
description = "Runs check:lint and check:unit: the fast set to run before every push."
depends = ["check:lint", "check:unit"]

[tasks."check:all"]
description = "Runs every check: part: the list CI runs."
depends = ["check:*"]

[tasks."check:lint"]
alias = ["lint", "fmt"]
description = "Runs every lint: task on the whole repo; no pre-commit."
# One at a time, since two fixers rewriting one file at once lose a fix. The outer mise run
# already provided the tools.
run = "mise run --skip-tools --jobs 1 --continue-on-error 'lint:*'"

[tasks."check:secrets"]
description = "Scans every commit on the branch since its base with gitleaks (the pre-commit hook sees only staged changes)."
run = '''
{% include "templates/_base/_diff_base.part" %}if git rev-parse -q --verify "$base^{commit}" >/dev/null; then range="$base..HEAD"; else range=HEAD; fi
gitleaks git --log-opts="$range" --redact --no-banner
'''
{% if include_agent_layer and agent_layer_mode != 'vendored' %}
[tasks."check:agents"]
description = "Runs agent:sync --frozen: the committed agent config matches apm.yml."
run = '''
if [ -f apm.lock.yaml ]; then
  # The outer mise run already provided the tools.
  mise run --skip-tools agent:sync -- --frozen
else
  # ponytail: an unsynced project has no lock to verify; the first committed sync arms this.
  echo "check:agents: no apm.lock.yaml yet, agent configuration not verified; run 'mise run agent:sync' and commit its output" >&2
fi
'''
{% endif %}
# Each lint: task is one linter's one definition: given files (the git hook passes the staged
# ones) it lints those, given none the whole repo. {{ scripts_dir }}/files-or-repo picks the files.
[tasks."lint:eof"]
description = "Ends each text file with exactly one newline; fixes in place."
run = '{{ scripts_dir }}/files-or-repo --text --skip "${APM_MANAGED:-}" end-of-file-fixer --'

[tasks."lint:whitespace"]
description = "Strips trailing whitespace; fixes in place."
run = '{{ scripts_dir }}/files-or-repo --text --skip "${APM_MANAGED:-}" trailing-whitespace-fixer --'

[tasks."lint:yaml"]
description = "Fails on a YAML file that doesn't parse."
run = '{{ scripts_dir }}/files-or-repo --only "\.ya?ml$" check-yaml --'

[tasks."lint:toml"]
description = "Fails on a TOML file that doesn't parse."
run = '{{ scripts_dir }}/files-or-repo --only "\.toml$" check-toml --'

[tasks."lint:json"]
description = "Fails on a JSON file that doesn't parse."
# LINT_JSON_SKIP, an ERE the project sets under [env], drops the paths that carry a .json name but
# hold no JSON (e.g. chezmoi modify_ scripts), so the project never edits this task.
run = '{{ scripts_dir }}/files-or-repo --only "\.json$" --skip "${LINT_JSON_SKIP:-}" check-json --'

[tasks."lint:merge-conflict"]
description = "Fails on a leftover conflict marker."
# --assume-in-merge: outside a merge the hook checks nothing, and CI is never inside one.
run = '{{ scripts_dir }}/files-or-repo --text check-merge-conflict --assume-in-merge --'

[tasks."lint:large-files"]
description = "Fails on a file over the size limit (1 MiB)."
# --enforce-all: without it only staged files count, and CI has none.
run = '{{ scripts_dir }}/files-or-repo check-added-large-files --maxkb=1024 --enforce-all --'

[tasks."lint:env"]
description = "Fails when .env is tracked."
# A hook's file arguments are ignored: the index holds a staged .env too.
run = '''
untracked() { if git ls-files --error-unmatch .env >/dev/null 2>&1; then echo "lint:env: .env is tracked; untrack it with git rm --cached .env (.gitignore lists it)" >&2; return 1; fi; }
untracked
'''

[tasks."lint:gitleaks"]
description = "Scans the given files (or the whole tree) for secrets."
# gitleaks dir takes one path and reads ignored files too, so the files are copied to a scratch tree.
run = '''
scan() {
  config="$PWD/.gitleaks.toml"
  tree="$(mktemp -d)"
  trap 'rm -rf "$tree"' EXIT
  if [ $# -gt 0 ]; then printf '%s\0' "$@"; else git ls-files -z; fi | tar --null -T - -cf - 2>/dev/null | tar -xf - -C "$tree"
  cd "$tree"
  if [ -f "$config" ]; then gitleaks dir . --redact --no-banner --config "$config"; else gitleaks dir . --redact --no-banner; fi
}
scan
'''

[tasks."lint:detect-secrets"]
description = "Fails on a secret not in the baseline."
# apm.lock.yaml (resolved SHAs and content hashes) and .copier-answers.yml (the template's ref
# and source) read as high-entropy strings and are generated, so they can't carry an inline
# allowlist pragma. lint:gitleaks still scans both.
run = '{{ scripts_dir }}/files-or-repo --text --skip "^(apm\.lock\.yaml|\.copier-answers\.yml)$" detect-secrets-hook --'

[tasks."lint:commit-msg"]
description = "Fails on a commit message that isn't a Conventional Commit; given none, checks the branch's commits since base."
run = '''
{% include "templates/_base/_diff_base.part" %}messages() {
  if [ $# -gt 0 ]; then conventional-pre-commit "$@"; return; fi
  # No base yet (before the first push): the last commit.
  if git rev-parse -q --verify "$base^{commit}" >/dev/null; then shas="$(git rev-list --no-merges "$base..HEAD")"; else shas="$(git rev-list --no-merges -1 HEAD)"; fi
  message="$(mktemp)"
  fail=0
  for sha in $shas; do
    git log -1 --format=%B "$sha" >"$message"
    conventional-pre-commit "$message" >/dev/null || { echo "lint:commit-msg: $(git log -1 --format='%h %s' "$sha") is not a Conventional Commit (type: summary)" >&2; fail=1; }
  done
  rm -f "$message"
  return "$fail"
}
messages
'''

[tasks."lint:actionlint"]
description = "Checks the GitHub workflows."
run = '{{ scripts_dir }}/files-or-repo --only "^\.github/workflows/[^/]+\.ya?ml$" actionlint --'

[tasks."lint:zizmor"]
description = "Checks the workflows for security mistakes."
run = '{{ scripts_dir }}/files-or-repo --only "^\.github/(workflows/[^/]+|dependabot)\.ya?ml$" zizmor --'

[tasks."lint:ghalint"]
description = "Checks the workflows against ghalint's policies, among them a timeout-minutes on every job."
run = '{{ scripts_dir }}/files-or-repo --only "^\.github/workflows/[^/]+\.ya?ml$" ghalint run --'

[tasks."lint:symlinks"]
description = "Fails on a broken or absolute symlink."
run = "{{ scripts_dir }}/check-symlinks.sh"
{% if include_ci %}
[tasks."ci:parts"]
description = "Prints the check: parts this change needs, for CI's matrix."
# BASE_REF is the change's base, as check:secrets reads it. A part with a key in
# .github/check-paths.yml runs only when a file changed since the merge base matches its filter;
# without a usable base (none set, as when run locally, all zeros, or a commit the checkout lacks)
# every part runs. A push lists no part when a merge_group run of this workflow already passed on its
# commit: a merge queue lands the commit it tested, so the push would repeat it; any other push, or a
# failed lookup, goes by the filters. In GitHub Actions it also writes the list to the step's output and summary.
run = '''
base=""
if [ -n "${BASE_REF:-}" ]; then
{% include "templates/_base/_diff_base.part" %}fi
mise tasks ls --json | BASE="$base" python3 -c '
import json, os, re, subprocess, sys
from pathlib import Path


def tested_by_the_queue():
    workflow = os.environ.get("GITHUB_WORKFLOW_REF", "").split("@")[0].rsplit("/", 1)[-1]
    query = "repos/{}/actions/workflows/{}/runs?event=merge_group&status=success&head_sha={}".format(
        os.environ.get("GITHUB_REPOSITORY"), workflow, os.environ.get("GITHUB_SHA"))
    try:
        found = subprocess.run(["gh", "api", query, "--jq", ".total_count"], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return False
    # Only a positive count is a found run: null, an error text or a negative number is a failed lookup.
    count = found.stdout.strip()
    return found.returncode == 0 and re.fullmatch("[0-9]+", count) is not None and int(count) > 0


# A mise monorepo root lists its own tasks as //:<task>, and CI runs them by the bare name.
names = [t["name"].removeprefix("//:") for t in json.load(sys.stdin)]
parts = sorted(name for name in names if name.startswith("check:") and name != "check:all")
paths = Path(".github/check-paths.yml")
# The project version alone may change in these files: a release bump is no change to test.
VERSION_FILES = ("pyproject.toml", "uv.lock", "package.json", "package-lock.json")
GLOB = {"**/": "(?:.*/)?", "/**": "/.*", "**": ".*", "*": "[^/]*"}


def git(*args):
    return os.fsdecode(subprocess.run(["git", *args], capture_output=True, check=True).stdout)


def read_filters(text):
    # ponytail: the YAML subset this file is written in (part keys over block lists of globs, or a
    # one-line flow list); any other line fails the plan, since a misread filter would skip a part silently.
    filters, globs = {}, None
    for number, line in enumerate(text.splitlines(), 1):
        bare = re.sub(r"(^|\s)#.*", "", line).strip()
        key = re.fullmatch(r"[\x22\x27]?(check:[\w:-]+)[\x22\x27]?\s*:(?:\s*\[(.*)\])?", bare)
        item = re.fullmatch(r"-\s+([\x22\x27]?)(.+?)\1", bare)
        if key and key.group(2) is not None:
            # An item is one quoted string with no comma, or a plain one that YAML reads as a string (no
            # leading * alias or & anchor, no brackets or quotes); anything else fails, nested or split lists too.
            flow = [re.fullmatch(r"\x22([^\x22,]*)\x22|\x27([^\x27,]*)\x27|([^\x22\x27\[\]&*\s][^\x22\x27\[\],]*)", glob.strip())
                    for glob in key.group(2).split(",") if glob.strip()]
            if not all(flow):
                sys.exit(f"{paths}:{number}: a flow list item this reader cannot read: {line}")
            filters.setdefault(key.group(1), []).extend(next(g for g in glob.groups() if g is not None) for glob in flow)
            globs = None
        elif key:
            globs = filters.setdefault(key.group(1), [])
        elif item and globs is not None:
            globs.append(item.group(2))
        elif bare not in ("", "{}"):
            sys.exit(f"{paths}:{number}: neither a check: part key nor a glob under one: {line}")
    return filters


def pattern(glob):
    # ponytail: ** and * only; braces, classes and ? match themselves.
    return re.compile("".join(GLOB.get(piece, re.escape(piece)) for piece in re.split(r"(\*\*/|/\*\*$|\*\*|\*)", glob)))


def matches(path, globs):
    hit = [glob for glob in globs if pattern(glob.removeprefix("!")).fullmatch(path)]
    return any(not glob.startswith("!") for glob in hit) and not any(glob.startswith("!") for glob in hit)


def without_own_version(name, text):
    if name in ("pyproject.toml", "uv.lock"):
        import tomllib  # Python 3.11+; without it the file counts as changed
        data = tomllib.loads(text)
    else:
        data = json.loads(text)
    if name == "pyproject.toml":
        data.get("project", {}).pop("version", None)
    elif name == "uv.lock":
        for package in data.get("package", []):
            if {"editable", "virtual"} & set(package.get("source", {})):
                package.pop("version", None)
    else:
        data.pop("version", None)
        if name == "package-lock.json":
            data.get("packages", {}).get("", {}).pop("version", None)
    return data


def version_only(path, merge_base):
    name = path.rsplit("/", 1)[-1]
    if name not in VERSION_FILES:
        return False
    try:  # a file missing on either side or that fails to parse counts as changed
        old, new = (without_own_version(name, git("show", f"{rev}:{path}")) for rev in (merge_base, "HEAD"))
        return old == new
    except Exception:
        return False


filters = read_filters(paths.read_text()) if paths.exists() else {}
base, changed = os.environ.get("BASE", ""), None
if not base:
    print("every part runs: BASE_REF is unset, so there is no base to compare with", file=sys.stderr)
else:
    try:
        merge_base = git("merge-base", base, "HEAD").strip()
        # --no-renames: a file moved out of a folder counts for that folder too.
        changed = [path for path in git("diff", "-z", "--no-renames", "--name-only", f"{base}...HEAD").split("\0") if path]
    except subprocess.CalledProcessError:
        print(f"every part runs: {base} is not in this checkout or shares no history with HEAD", file=sys.stderr)
if changed is not None:
    for path in [path for path in changed if version_only(path, merge_base)]:
        print(f"{path}: only the project version changed, not counted", file=sys.stderr)
        changed.remove(path)
run = [part for part in parts
       if part not in filters or changed is None or any(matches(path, filters[part]) for path in changed)]
skipped = [part for part in parts if part not in run]
queued = os.environ.get("GITHUB_EVENT_NAME") == "push" and tested_by_the_queue()
if queued:
    run, skipped = [], []
print(json.dumps(run))
if queued:
    print("skipped every part: a merge_group run of this workflow passed on this commit", file=sys.stderr)
for part in skipped:
    print(f"skipped {part}: its filter in {paths} matched no changed file", file=sys.stderr)
if os.environ.get("GITHUB_OUTPUT"):
    with open(os.environ["GITHUB_OUTPUT"], "a") as out:
        out.write(f"parts={json.dumps(run)}\n")
if os.environ.get("GITHUB_STEP_SUMMARY"):
    with open(os.environ["GITHUB_STEP_SUMMARY"], "a") as out:
        if queued:
            out.write("- every part: skipped, the merge queue tested this commit\n")
        out.write("".join(f"- `{part}`: runs\n" for part in run))
        out.write("".join(f"- `{part}`: skipped, its path filter matched no change\n" for part in skipped))
'
'''

[tasks."ci:check"]
description = "CI's aggregate check: fails unless the plan and every part passed, naming each failed part and the command that reruns it."
# PLAN and PARTS are the plan and matrix jobs' results, PLANNED the plan's parts: none skips the
# matrix.
# Locally `mise run check` is only the fast set, so a failed part names its own command.
run = '''
if [ "${PLAN:-}" = success ] && [ "${PARTS:-}" = success ]; then echo "every check: part passed"; exit 0; fi
if [ "${PLAN:-}" = success ] && [ "${PARTS:-}" = skipped ] && [ "${PLANNED:-}" = "[]" ]; then
  echo "the plan listed no check: part"
  exit 0
fi
echo "::error::plan: ${PLAN:-unknown}, parts: ${PARTS:-unknown}"
failed="$(gh api --paginate "repos/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID/attempts/$GITHUB_RUN_ATTEMPT/jobs" --jq '.jobs[] | select(.conclusion == "failure" or .conclusion == "cancelled") | .name')" || failed=""
for part in $failed; do
  case "$part" in check:*) echo "::error::$part failed; rerun it with: mise run $part" ;; esac
done
exit 1
'''
{% endif -%}
[tasks."deps:renovate"]
description = "Runs Renovate (renovate.json) on this repo with your gh login: opens or updates its dependency PRs. `-- --branch <name>` instead dry-runs that branch with this checkout's renovate.json and opens nothing. Needs gh logged in with the repo and workflow scopes."
# Self-hosted with the developer's own token, so it needs no org admin: the PRs are theirs, and a PR
# a user token opens starts CI. The admin settings are this process's environment. Pass Renovate's
# own flags after --, such as --dry-run=full.
run = """
command -v gh >/dev/null || { echo "error: gh is required; install the GitHub CLI and run 'gh auth login'" >&2; exit 127; }
token="$(gh auth token 2>/dev/null)" || { echo "deps:renovate: gh is not logged in; run 'gh auth login'" >&2; exit 1; }
# An OAuth or classic token names its scopes in this header; a token without the header is let through.
scopes="$(gh api -i user 2>/dev/null | tr -d '\\r' | sed -n 's/^[Xx]-[Oo][Aa]uth-[Ss]copes: //p')"
if [ -n "$scopes" ]; then
  for scope in repo workflow; do
    case ", $scopes," in *", $scope,"*) ;; *) echo "deps:renovate: the gh token lacks the $scope scope; run 'gh auth refresh -s repo,workflow'" >&2; exit 1 ;; esac
  done
fi
base="${XDG_CACHE_HOME:-$HOME/.cache}/renovate"
export RENOVATE_TOKEN="$token" RENOVATE_PLATFORM=github RENOVATE_ONBOARDING=false RENOVATE_REQUIRE_CONFIG=required \\
  RENOVATE_REPOSITORIES="$(gh repo view --json nameWithOwner --jq .nameWithOwner)" \\
  RENOVATE_ALLOW_SCRIPTS=true RENOVATE_ALLOWED_COMMANDS='[{% if include_agent_layer %}"^mise run agent:sync -- --refresh$"{% endif %}]' \\
  RENOVATE_BINARY_SOURCE=global RENOVATE_BASE_DIR="$base" \\
  RENOVATE_GIT_AUTHOR="$(git config user.name) <$(git config user.email)>" \\
  MISE_TRUSTED_CONFIG_PATHS="$base${MISE_TRUSTED_CONFIG_PATHS:+:$MISE_TRUSTED_CONFIG_PATHS}"
# mise appends the task's arguments to the script's last line, so that line calls a function.
run_renovate() {
  # Proof for a branch's renovate.json before it lands: Renovate reads this checkout's file as its
  # config and dry-runs only that branch. Renovate only warns on a config error, so the validator
  # runs first and its failure is the task's.
  if [ "${1:-}" = --branch ]; then
    [ -n "${2:-}" ] || { echo "deps:renovate: --branch needs a branch name" >&2; exit 2; }
    mise exec node@24.21.0 -- npx --yes --package renovate@44.145.1 -- renovate-config-validator renovate.json || exit
    export RENOVATE_CONFIG_FILE="$PWD/renovate.json" RENOVATE_BASE_BRANCH_PATTERNS="[\\"$2\\"]" \\
      RENOVATE_REQUIRE_CONFIG=ignored RENOVATE_DRY_RUN=full
    shift 2
  fi
  exec mise exec node@24.21.0 -- npx --yes renovate@44.145.1 "$@"
}
run_renovate "$@"
"""
{% if include_agent_layer %}
[tasks."deps:renovate-weekly"]
description = "The weekly workflow's step: runs deps:renovate with the RENOVATE_TOKEN secret, or says it is unset and ends green."
# A PR opened with the workflow's own github.token starts no CI, so the workflow passes a token or
# App secret instead. Without it nothing is opened and nothing fails.
run = """
if [ -z "${RENOVATE_TOKEN:-}" ]; then
  echo "::notice title=Renovate skipped::The RENOVATE_TOKEN secret is not set, so no dependency PRs are opened. Add a token with contents and pull-requests write as a repo or org secret named RENOVATE_TOKEN; see the README, Dependency updates: Renovate."
  exit 0
fi
export GH_TOKEN="$RENOVATE_TOKEN"
git config --global user.name renovate
git config --global user.email renovate@users.noreply.github.com
mise run deps:renovate
"""
{% endif %}
