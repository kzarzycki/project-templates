{% set scripts_dir = scripts_dir | default("scripts") -%}
{% if include_agent_layer -%}
[env]
{% if agent_layer_mode == 'vendored' -%}
# APM hash-tracks every file it deploys, so a fix there is drift that `mise run agent:sync` refuses
# over: the fixing lint: tasks skip these trees. The secret scanners still read them.
APM_MANAGED = '^(\.agents|\.claude|\.codex)/'
{% else -%}
# APM owns these trees and hash-tracks every file it deploys, so a fix there is drift that
# fails `mise run check:agents`: the fixing lint: tasks skip them. The secret scanners still read them.
APM_MANAGED = '^(\.agents|\.claude|\.codex|\.github/instructions)/|(^|/)AGENTS\.md$|/CLAUDE\.md$'
{% endif %}
{% endif -%}
{% if include_ci %}# The merge checks: every check: task but check:all is a part, and CI runs each as its own
# job named after it (mise run ci:parts). Add a part here and CI runs it; give it a path
# filter in .github/check-paths.yml.
{% else %}# The merge checks: every check: task but check:all is a part. With no CI (loop.md `CI: none`),
# the merge proof is approvals.py local-ci, which runs them on a clean checkout of the head.
{% endif %}[tasks.check]
description = "Runs check:lint and check:unit: the fast set to run before every push."
depends = ["check:lint", "check:unit"]

[tasks."check:all"]
description = "Runs every check: part: the list GitHub and the merge queue run."
depends = ["check:*"]

[tasks."check:lint"]
alias = ["lint", "fmt"]
description = "Runs every lint: task on the whole repo; no pre-commit."
# One at a time, since two fixers rewriting one file at once lose a fix. The outer mise run
# already provided the tools.
run = "mise run --skip-tools --jobs 1 --continue-on-error 'lint:*'"

[tasks."check:secrets"]
description = "Scans every commit on the branch since its base with gitleaks (the pre-commit hook sees only staged changes)."
run = '''
{% include "templates/_base/_diff_base.part" %}if git rev-parse -q --verify "$base^{commit}" >/dev/null; then range="$base..HEAD"; else range=HEAD; fi
gitleaks git --log-opts="$range" --redact --no-banner
'''
{% if include_agent_layer and agent_layer_mode != 'vendored' %}
[tasks."check:agents"]
description = "Runs agent:sync --frozen: the committed agent config matches apm.yml."
run = '''
if [ -f apm.lock.yaml ]; then
  # The outer mise run already provided the tools.
  mise run --skip-tools agent:sync -- --frozen
else
  # ponytail: an unsynced project has no lock to verify; the first committed sync arms this.
  echo "check:agents: no apm.lock.yaml yet, agent configuration not verified; run 'mise run agent:sync' and commit its output" >&2
fi
'''
{% endif %}
# Each lint: task is one linter's one definition: given files (the git hook passes the staged
# ones) it lints those, given none the whole repo. {{ scripts_dir }}/files-or-repo picks the files.
[tasks."lint:eof"]
description = "Ends each text file with exactly one newline; fixes in place."
run = '{{ scripts_dir }}/files-or-repo --text --skip "${APM_MANAGED:-}" end-of-file-fixer --'

[tasks."lint:whitespace"]
description = "Strips trailing whitespace; fixes in place."
run = '{{ scripts_dir }}/files-or-repo --text --skip "${APM_MANAGED:-}" trailing-whitespace-fixer --'

[tasks."lint:yaml"]
description = "Fails on a YAML file that doesn't parse."
run = '{{ scripts_dir }}/files-or-repo --only "\.ya?ml$" check-yaml --'

[tasks."lint:toml"]
description = "Fails on a TOML file that doesn't parse."
run = '{{ scripts_dir }}/files-or-repo --only "\.toml$" check-toml --'

[tasks."lint:json"]
description = "Fails on a JSON file that doesn't parse."
# LINT_JSON_SKIP, an ERE the project sets under [env], drops the paths that carry a .json name but
# hold no JSON (e.g. chezmoi modify_ scripts), so the project never edits this task.
run = '{{ scripts_dir }}/files-or-repo --only "\.json$" --skip "${LINT_JSON_SKIP:-}" check-json --'

[tasks."lint:merge-conflict"]
description = "Fails on a leftover conflict marker."
# --assume-in-merge: outside a merge the hook checks nothing, and CI is never inside one.
run = '{{ scripts_dir }}/files-or-repo --text check-merge-conflict --assume-in-merge --'

[tasks."lint:large-files"]
description = "Fails on a file over the size limit (1 MiB)."
# --enforce-all: without it only staged files count, and CI has none.
run = '{{ scripts_dir }}/files-or-repo check-added-large-files --maxkb=1024 --enforce-all --'

[tasks."lint:env"]
description = "Fails when .env is tracked."
# A hook's file arguments are ignored: the index holds a staged .env too.
run = '''
untracked() { if git ls-files --error-unmatch .env >/dev/null 2>&1; then echo "lint:env: .env is tracked; untrack it with git rm --cached .env (.gitignore lists it)" >&2; return 1; fi; }
untracked
'''

[tasks."lint:gitleaks"]
description = "Scans the given files (or the whole tree) for secrets."
# gitleaks dir takes one path and reads ignored files too, so the files are copied to a scratch tree.
run = '''
scan() {
  config="$PWD/.gitleaks.toml"
  tree="$(mktemp -d)"
  trap 'rm -rf "$tree"' EXIT
  if [ $# -gt 0 ]; then printf '%s\0' "$@"; else git ls-files -z; fi | tar --null -T - -cf - 2>/dev/null | tar -xf - -C "$tree"
  cd "$tree"
  if [ -f "$config" ]; then gitleaks dir . --redact --no-banner --config "$config"; else gitleaks dir . --redact --no-banner; fi
}
scan
'''

[tasks."lint:detect-secrets"]
description = "Fails on a secret not in the baseline."
# apm.lock.yaml (resolved SHAs and content hashes) and .copier-answers.yml (the template's ref
# and source) read as high-entropy strings and are generated, so they can't carry an inline
# allowlist pragma. lint:gitleaks still scans both.
run = '{{ scripts_dir }}/files-or-repo --text --skip "^(apm\.lock\.yaml|\.copier-answers\.yml)$" detect-secrets-hook --'

[tasks."lint:commit-msg"]
description = "Fails on a commit message that isn't a Conventional Commit; given none, checks the branch's commits since base."
run = '''
{% include "templates/_base/_diff_base.part" %}messages() {
  if [ $# -gt 0 ]; then conventional-pre-commit "$@"; return; fi
  # No base yet (before the first push): the last commit.
  if git rev-parse -q --verify "$base^{commit}" >/dev/null; then shas="$(git rev-list --no-merges "$base..HEAD")"; else shas="$(git rev-list --no-merges -1 HEAD)"; fi
  message="$(mktemp)"
  fail=0
  for sha in $shas; do
    git log -1 --format=%B "$sha" >"$message"
    conventional-pre-commit "$message" >/dev/null || { echo "lint:commit-msg: $(git log -1 --format='%h %s' "$sha") is not a Conventional Commit (type: summary)" >&2; fail=1; }
  done
  rm -f "$message"
  return "$fail"
}
messages
'''

[tasks."lint:actionlint"]
description = "Checks the GitHub workflows."
run = '{{ scripts_dir }}/files-or-repo --only "^\.github/workflows/[^/]+\.ya?ml$" actionlint --'

[tasks."lint:zizmor"]
description = "Checks the workflows for security mistakes."
run = '{{ scripts_dir }}/files-or-repo --only "^\.github/(workflows/[^/]+|dependabot)\.ya?ml$" zizmor --'

[tasks."lint:symlinks"]
description = "Fails on a broken or absolute symlink."
run = "{{ scripts_dir }}/check-symlinks.sh"
{% if include_ci %}
[tasks."ci:parts"]
description = "Prints the check: parts this change needs, for CI's matrix."
# A part with a key in .github/check-paths.yml runs only when its filter matched: CHANGES is the
# keys that matched, as JSON (dorny/paths-filter's `changes`). Without CHANGES every part runs.
# In GitHub Actions it also writes the list to the step's output and summary.
run = '''
mise tasks ls --json | python3 -c '
import json, os, re, sys
from pathlib import Path

# A mise monorepo root lists its own tasks as //:<task>, and CI runs them by the bare name.
names = [t["name"].removeprefix("//:") for t in json.load(sys.stdin)]
parts = sorted(name for name in names if name.startswith("check:") and name != "check:all")
paths = Path(".github/check-paths.yml")
key = re.compile(r"^[\x22\x27]?(check:[\w:-]+)[\x22\x27]?[ \t]*:(?:[ \t]|$)", re.MULTILINE)
filtered = set(key.findall(paths.read_text())) if paths.exists() else set()
changes = os.environ.get("CHANGES")
matched = set(json.loads(changes or "[]")) if changes is not None else set(filtered)
run = [part for part in parts if part not in filtered or part in matched]
skipped = [part for part in parts if part not in run]
print(json.dumps(run))
for part in skipped:
    print(f"skipped {part}: its filter in {paths} matched no changed file", file=sys.stderr)
if os.environ.get("GITHUB_OUTPUT"):
    with open(os.environ["GITHUB_OUTPUT"], "a") as out:
        out.write(f"parts={json.dumps(run)}\n")
if os.environ.get("GITHUB_STEP_SUMMARY"):
    with open(os.environ["GITHUB_STEP_SUMMARY"], "a") as out:
        out.write("".join(f"- `{part}`: runs\n" for part in run))
        out.write("".join(f"- `{part}`: skipped, its path filter matched no change\n" for part in skipped))
'
'''

[tasks."ci:check"]
description = "CI's aggregate check: fails unless the plan and every part passed, naming each failed part and the command that reruns it."
# PLAN and PARTS are the plan and matrix jobs' results. Locally `mise run check` is only the
# fast set, so a failed part names its own command.
run = '''
if [ "${PLAN:-}" = success ] && [ "${PARTS:-}" = success ]; then echo "every check: part passed"; exit 0; fi
echo "::error::plan: ${PLAN:-unknown}, parts: ${PARTS:-unknown}"
failed="$(gh api --paginate "repos/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID/attempts/$GITHUB_RUN_ATTEMPT/jobs" --jq '.jobs[] | select(.conclusion == "failure" or .conclusion == "cancelled") | .name')" || failed=""
for part in $failed; do
  case "$part" in check:*) echo "::error::$part failed; rerun it with: mise run $part" ;; esac
done
exit 1
'''
{% endif -%}
[tasks."deps:update"]
description = "Moves the project to the newest template tag{% if include_agent_layer %}, and each APM package of the template's GitHub owner to its newest release{% endif %}, in one commit. Prints 'deps:update: current' when nothing changed. Exits 1 on a dirty tree or a conflict, and leaves the tree as it is."
# A commit pin moves to the newest release when that release contains it, else to its repo's main.
run = """
set -eu
if [ -n "$(git status --porcelain)" ]; then
  echo "deps:update: the tree has uncommitted changes; commit them first" >&2
  exit 1
fi
body="$(mktemp)"
trap 'rm -f "$body"' EXIT
if [ -f .copier-answers.yml ]; then
  answer() { sed -n "s/^$1: *//p" .copier-answers.yml; }
  old="$(answer _commit)"
  copier update --trust --defaults --conflict inline
  new="$(answer _commit)"
  conflicted="$(git diff --name-only -G '^<<<<<<< ')"
  if [ -n "$conflicted" ]; then
    echo "deps:update: copier update $old..$new left conflicts in:" >&2
    echo "$conflicted" >&2
    exit 1
  fi
  repo="$(answer _src_path | sed -E 's#^(gh:|https://github.com/|git@github.com:)##; s#\\.git$##')"
  if [ "$old" != "$new" ]; then echo "template: $old -> $new (https://github.com/$repo/compare/$old...$new)" >> "$body"; fi
fi
{% if include_agent_layer -%}
python3 - "$body" <<'PY'
import re
import subprocess
import sys
import tempfile
from pathlib import Path

answers = Path(".copier-answers.yml")
source = re.search(r"^_src_path: *(?:gh:|https://github\\.com/|git@github\\.com:)([\\w.-]+)/", answers.read_text(), re.M) if answers.is_file() else None
if source is None:
    sys.exit(0)  # no template owner: whose packages to move is unknown
owner = source.group(1)


def git(*arguments):
    return subprocess.run(["git", *arguments], check=True, capture_output=True, text=True).stdout


# The newest release of a package: tags <prefix>vX.Y.Z, where a package in a subdirectory
# (owner/repo/name) tags "name-v", as the engineering pack does.
def newest(repo, prefix):
    versions = []
    for line in git("ls-remote", "--tags", "--refs", f"https://github.com/{repo}").splitlines():
        tag = line.split("\\t")[1].removeprefix("refs/tags/")
        match = re.fullmatch(re.escape(prefix) + r"v(\\d+)\\.(\\d+)\\.(\\d+)", tag)
        if match:
            versions.append((tuple(map(int, match.groups())), tag))
    return max(versions) if versions else (None, None)


def contains(repo, tag, commit):
    with tempfile.TemporaryDirectory() as bare:
        git("init", "-q", "--bare", bare)
        git("-C", bare, "fetch", "-q", "--filter=tree:0", f"https://github.com/{repo}", f"refs/tags/{tag}:refs/tags/{tag}")
        return subprocess.run(["git", "-C", bare, "merge-base", "--is-ancestor", commit, tag + "^{commit}"],
                              capture_output=True).returncode == 0


def moved(package, ref):
    parts = package.split("/")
    repo, prefix = "/".join(parts[:2]), (parts[-1] + "-" if len(parts) > 2 else "")
    version, tag = newest(repo, prefix)
    dotted = ".".join(map(str, version)) if version else None
    if range_ := re.fullmatch(r"([\\^~])(\\d+)\\.(\\d+)\\.(\\d+)", ref):
        if version and version > tuple(map(int, range_.groups()[1:])):
            return f"{range_.group(1)}{dotted}", repo, f"{prefix}v{range_.group(2)}.{range_.group(3)}.{range_.group(4)}", tag
    elif pinned := re.fullmatch(re.escape(prefix) + r"v(\\d+)\\.(\\d+)\\.(\\d+)", ref):
        if version and version > tuple(map(int, pinned.groups())):
            return tag, repo, ref, tag
    elif re.fullmatch(r"[0-9a-f]{40}", ref):
        if tag and contains(repo, tag, ref):
            return f"^{dotted}", repo, ref, tag
        head = git("ls-remote", f"https://github.com/{repo}", "refs/heads/main").split("\\t")[0]
        if head and head != ref:
            return head, repo, ref, head
    return None


lines = Path("apm.yml").read_text().splitlines(keepends=True)
changes, item = [], None
for number, line in enumerate(lines):
    if start := re.match(r"\\s*-\\s+git:\\s*(\\S+)", line):
        item = (start.group(1), number)
    elif item and (ref := re.match(r"(\\s*)ref:\\s*(\\S+)", line)):
        package, first = item
        item = None
        if not package.startswith(f"{owner}/"):
            continue
        change = moved(package, ref.group(2))
        if change is None:
            continue
        new, repo, base, head = change
        # A comment on a commit pin says why it is one, so it goes with the commit.
        if re.fullmatch(r"[0-9a-f]{40}", ref.group(2)) and not re.fullmatch(r"[0-9a-f]{40}", new):
            for between in range(first + 1, number):
                if lines[between].strip().startswith("#"):
                    lines[between] = ""
            lines[number] = f"{ref.group(1)}ref: {new}\\n"
        else:
            lines[number] = line.replace(ref.group(2), new, 1)
        changes.append(f"{package}: {ref.group(2)} -> {new} (https://github.com/{repo}/compare/{base}...{head})\\n")
Path("apm.yml").write_text("".join(lines))
with open(sys.argv[1], "a") as body:
    body.writelines(changes)
PY
mise run --skip-tools agent:sync -- --refresh
{% endif -%}
if [ -z "$(git status --porcelain)" ]; then
  echo "deps:update: current"
  exit 0
fi
git add -A
{ echo "chore(deps): update template and owner packages"; echo; cat "$body"; } | git commit -q -F -
cat "$body"
git log -1 --format='deps:update: committed %h'
"""
{% if loop_enabled %}
[tasks."loop:approvals"]
alias = "gate"
description = "Checks the loop's proofs on GitHub: approved spec, verdict, Evidence, merge approval. merge exits 3 while it waits for check, or for the owner's approved:merge on a high-risk PR."
usage = '''
arg "<point>" help="build or merge"
arg "[pr]" help="the PR number; default: this branch's PR"
'''
# Add the project's own checks as more lines; the task stops at the first that fails.
# ponytail: the path is the codex target's copy; without codex, point it at .claude/skills.
run = [
  'test -f .agents/skills/engineering-loop/scripts/approvals.py || { echo "loop:approvals: the engineering-loop skill is not installed; run mise run agent:sync and commit its output" >&2; exit 1; }',
  'python3 .agents/skills/engineering-loop/scripts/approvals.py check "${usage_point}" ${usage_pr:-}',
]

[tasks."loop:land"]
description = "The one way an agent lands a PR: every merge proof, then ready and a squash merge pinned to the head, or auto-merge while required checks are pending. Exits 0 merged or auto-merge on, 1 on a missing proof, 3 while it waits."
usage = '''
arg "<pr>" help="the PR number"
'''
# ponytail: the path is the codex target's copy; without codex, point it at .claude/skills.
run = [
  'test -f .agents/skills/engineering-loop/scripts/approvals.py || { echo "loop:land: the engineering-loop skill is not installed; run mise run agent:sync and commit its output" >&2; exit 1; }',
  'python3 .agents/skills/engineering-loop/scripts/approvals.py land "${usage_pr}"',
]

[tasks."ci:approvals"]
description = "CI's approvals step: posts loop:approvals merge's result as the loop:approvals commit status on the PR head (pending while it waits); success on a merge-queue commit; a push removes approved:merge first; on success turns on auto-merge at the head unless the PR has a request or the repo has no auto-merge."
# A job ends only as success or failure, and GitHub counts a skipped job as passed, so the
# result is a commit status, which main's ruleset requires. The workflow sets EVENT, ACTION,
# PR, QUEUE_HEAD and RUN_URL.
run = '''
post() {
  gh api -X POST "repos/$GITHUB_REPOSITORY/statuses/$1" -f state="$2" -f context=loop:approvals \
    -f description="$(printf '%s' "$3" | cut -c1-140)" -f target_url="$RUN_URL" >/dev/null
  echo "loop:approvals: $2 on $1: $3"
}
if [ "$EVENT" = merge_group ]; then
  # A PR is queued only with the status green on its head, so the queue's commit passes.
  post "$QUEUE_HEAD" success "checked on the PR before it was queued"
  exit 0
fi
[ -n "${PR:-}" ] || { echo "ci:approvals: no PR for this run; nothing to post"; exit 0; }
pull="$(gh pr view "$PR" --json headRefOid,isDraft,author,autoMergeRequest --jq '[.headRefOid, .isDraft, .author.login, .autoMergeRequest != null] | @tsv')"
head="$(printf '%s' "$pull" | cut -f1)"
if [ "$(printf '%s' "$pull" | cut -f2)" = true ]; then echo "ci:approvals: PR #$PR is a draft; nothing to post"; exit 0; fi
if [ "$(printf '%s' "$pull" | cut -f3)" = "app/dependabot" ]; then
  post "$head" success "a dependabot update carries no loop proofs"
  exit 0
fi
if [ "$ACTION" = synchronize ]; then
  # The label never covers a head the owner didn't see. A 404 means it was not on the PR.
  out="$(gh api -X DELETE "repos/$GITHUB_REPOSITORY/issues/$PR/labels/approved:merge" 2>&1)" || case "$out" in
    *"HTTP 404"*) ;;
    *) post "$head" failure "could not remove approved:merge after the push"; echo "ci:approvals: could not remove approved:merge: $out" >&2; exit 1 ;;
  esac
fi
code=0
out="$(mise run --quiet --skip-tools loop:approvals merge "$PR")" || code=$?
printf '%s\n' "$out"
first="$(printf '%s\n' "$out" | sed -n 1p)"
case "$code" in
  0) post "$head" success "${first:-every proof holds}" ;;
  3) post "$head" pending "$first"; exit 0 ;;
  *) post "$head" failure "${first:-loop:approvals exited $code}"; exit 1 ;;
esac
# Every proof holds on a ready PR (a draft returned above), so a PR made ready by hand lands with no agent
# action. A request already there is left alone. The merge this makes starts main's push workflows only
# when the workflow runs with a GitHub App's token (APPROVALS_APP_CLIENT_ID), not with github.token.
# Pinned to the head the proofs covered; gh merges at once when nothing is pending.
if [ "$(printf '%s' "$pull" | cut -f4)" = true ]; then echo "ci:approvals: PR #$PR already has auto-merge on; left as is"; exit 0; fi
# On a repo without auto-merge (a private repo on GitHub Free cannot turn it on) and with no required
# check pending, gh pr merge --auto merges at once with github.token: no push workflow starts on main
# and loop:land's pinned merge is skipped. So the job stops at the status there, as it does when the
# setting can't be read, and mise run loop:land lands the PR with the agent's own token.
auto="$(gh api "repos/$GITHUB_REPOSITORY" --jq .allow_auto_merge)" || {
  echo "::error::ci:approvals: could not read the repo's auto-merge setting; loop:approvals is still success, so mise run loop:land $PR lands PR #$PR"
  exit 1
}
if [ "$auto" != true ]; then echo "ci:approvals: the repo has no auto-merge, so mise run loop:land $PR lands PR #$PR"; exit 0; fi
gh pr merge "$PR" --auto --squash --match-head-commit "$head" || {
  echo "::error::ci:approvals: could not turn on auto-merge for PR #$PR at $head; loop:approvals is still success, so mise run loop:land $PR lands it"
  exit 1
}
'''

[tasks."setup:github"]
alias = "merge-queue"
description = "Writes GitHub settings (the ruleset, auto-merge, head branch deletion; on a plan without rulesets, squash-only merges and head branch deletion), then syncs the labels with the pack's labels.py, from the repo's files; runs no checks. --dry-run prints the label plan and writes nothing; --revert deletes the ruleset."
usage = '''
flag "--revert" help="Delete the loop-merge-queue ruleset; the repository settings are restored with the command apply printed"
flag "--dry-run" help="Print what labels.py would change; write nothing to GitHub (no ruleset, settings or labels)"
'''
# The task owns only the ruleset named loop-merge-queue and never reads or changes another one:
# GitHub layers every active ruleset on a branch, so the repo's own rules keep applying.
{% if include_ci %}# The ruleset requires CI's `check` job and the `loop:approvals` status by name: rename one, update
# the ruleset, rerun this.
{% else %}# The ruleset requires the `loop:approvals` status by name: rename it, update the ruleset, rerun this.
{% endif %}run = '''
command -v gh >/dev/null || { echo "error: gh is required; install the GitHub CLI and run 'gh auth login'" >&2; exit 127; }
# The labels are the pack's: labels.py is their one definition, read from docs/agents/issue-tracker.md.
# ponytail: the path is the codex target's copy; without codex, point it at .claude/skills.
labels=.agents/skills/engineering-loop/scripts/labels.py
# Checked before any write, so a missing skill never leaves the ruleset applied and the labels not.
if [ "${usage_revert:-false}" = true ]; then
  if [ "${usage_dry_run:-false}" = true ]; then echo "error: --dry-run and --revert cannot be combined" >&2; exit 2; fi
elif [ ! -f "$labels" ]; then
  echo "setup:github: the engineering-loop skill is not installed; run mise run agent:sync and commit its output" >&2
  exit 1
elif [ "${usage_dry_run:-false}" = true ]; then
  echo "dry run: the ruleset and repository settings are left as they are"
  exec python3 "$labels" --dry-run
fi
# A private repo on GitHub Free has no rulesets and no auto-merge: GitHub answers the rules read with this 403,
# the probe the pack's land uses. Any other error stops the task.
free=false
if ! probe="$(gh api 'repos/{owner}/{repo}/rules/branches/main' 2>&1 >/dev/null)"; then
  case "$probe" in *"Upgrade to GitHub Pro"*"(HTTP 403)"*) free=true ;; *) echo "$probe" >&2; exit 1 ;; esac
fi
if [ "$free" = true ] && [ "${usage_revert:-false}" = true ]; then echo "no rulesets on this plan: nothing to revert"; exit 0; fi
if [ "$free" = true ]; then
  # Squash-only merges and head branch deletion are what Free allows; the ruleset and auto-merge are skipped.
  # A standalone assignment, so a failed read stops the task before the PATCH loses the previous values.
  settings="$(gh api 'repos/{owner}/{repo}' --jq '.allow_merge_commit, .allow_rebase_merge, .allow_squash_merge, .delete_branch_on_merge')"
  set -- $settings
  gh api -X PATCH 'repos/{owner}/{repo}' -F allow_merge_commit=false -F allow_rebase_merge=false \
    -F allow_squash_merge=true -F delete_branch_on_merge=true >/dev/null
  echo "allow_merge_commit was $1, allow_rebase_merge was $2, allow_squash_merge was $3, delete_branch_on_merge was $4;" \
    "restore: gh api -X PATCH 'repos/{owner}/{repo}' -F allow_merge_commit=$1 -F allow_rebase_merge=$2 -F allow_squash_merge=$3 -F delete_branch_on_merge=$4"
  echo "GitHub enforces nothing on main here (this plan has no rulesets or auto-merge): no ruleset applied, mise run loop:land is the only gate"
else
  id="$(gh api --paginate 'repos/{owner}/{repo}/rulesets' --jq '.[] | select(.source_type == "Repository" and .name == "loop-merge-queue") | .id')"
  if [ "${usage_revert:-false}" = true ]; then
    if [ -z "$id" ]; then echo "no loop-merge-queue ruleset: nothing to revert"; exit 0; fi
    # A 404 means another run deleted it first: the revert is done either way.
    out="$(gh api -X DELETE "repos/{owner}/{repo}/rulesets/$id" 2>&1)" || case "$out" in *"HTTP 404"*) ;; *) echo "$out" >&2; exit 1 ;; esac
    echo "deleted ruleset loop-merge-queue ($id)"
    exit 0
  fi
  if [ -n "$id" ]; then
    gh api -X PUT "repos/{owner}/{repo}/rulesets/$id" --input .github/rulesets/main.json --jq '"updated ruleset loop-merge-queue (\(.id))"'
  else
    gh api -X POST 'repos/{owner}/{repo}/rulesets' --input .github/rulesets/main.json --jq '"created ruleset loop-merge-queue (\(.id))"'
  fi
  # Auto-merge lets a ready PR merge once its checks pass; GitHub deletes the merged head branch.
  auto="$(gh api 'repos/{owner}/{repo}' --jq .allow_auto_merge)"
  delete="$(gh api 'repos/{owner}/{repo}' --jq .delete_branch_on_merge)"
  gh api -X PATCH 'repos/{owner}/{repo}' -F allow_auto_merge=true -F delete_branch_on_merge=true >/dev/null
  echo "allow_auto_merge was $auto, delete_branch_on_merge was $delete, both now true; restore: gh api -X PATCH 'repos/{owner}/{repo}' -F allow_auto_merge=$auto -F delete_branch_on_merge=$delete"
  echo "revert the ruleset: mise run setup:github --revert"
fi
# The approvals workflow's token: a merge it makes starts main's push workflows only with an App's.
if gh api 'repos/{owner}/{repo}/actions/variables/APPROVALS_APP_CLIENT_ID' >/dev/null 2>&1; then
  if gh api 'repos/{owner}/{repo}/actions/secrets/APPROVALS_APP_PRIVATE_KEY' >/dev/null 2>&1; then
    echo "approvals workflow: runs with the GitHub App APPROVALS_APP_CLIENT_ID names"
  else
    echo "approvals workflow: APPROVALS_APP_CLIENT_ID is set but the secret APPROVALS_APP_PRIVATE_KEY is not, so every run fails; set it"
  fi
else
  echo "approvals workflow: runs with github.token, so a merge it makes starts no push workflow on main;" \
    "to change that, set the repo variable APPROVALS_APP_CLIENT_ID and the secret APPROVALS_APP_PRIVATE_KEY for a GitHub App" \
    "with Contents, Pull requests and Commit statuses write and Issues, Checks and Actions read, installed on this repo"
fi
python3 "$labels"
'''
{% endif -%}
