# Carries a PR review{% if merge_queue %} and a merge-queue entry{% endif %} to the Approvals workflow. {% if merge_queue %}Both events run{% else %}A review runs{% endif %} the PR's
# own copy of the workflow file, so this one holds no token and no secret and does nothing: its
# completion starts `approvals.yml` (workflow_run), which runs main's copy with the write token.
name: Approvals relay
on:
  # The verifier's verdict is a review: a new or dismissed one updates the status.
  pull_request_review:
    types: [submitted, dismissed]
{% if merge_queue %}  # The queue's commit gets success: a PR is queued only once its status was green.
  merge_group:
{% endif %}
permissions: {}

# A PR's newer review cancels its older relay run.
{% if merge_queue %}# A queue entry has no PR and keeps its own run.
{% endif %}concurrency:
  group: {% raw %}approvals-relay-${{ github.event.pull_request.number || github.sha }}{% endraw %}
  cancel-in-progress: true

jobs:
  relay:
{% if github_repository %}    if: {% raw %}${{ {% endraw %}{{ repository_guard }}{% raw %}true }}{% endraw %}
{% endif %}    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - run: echo "relayed to the Approvals workflow"
