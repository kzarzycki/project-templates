name: {{ project_name }}
version: 0.1.0
description: {{ description }}
author: {{ author }}
# Add each coding agent's APM mapping here. Claude Code and Codex are the
# currently implemented and acceptance-tested integrations.
targets:
- claude
- codex
dependencies:
{% if include_engineering_workflow -%}
  apm:
{% if engineering_capability_ref -%}
    - git: {{ engineering_capability_source }}
      ref: {{ engineering_capability_ref }}
{% else -%}
    - {{ engineering_capability_source }}
{% endif -%}
{% else -%}
  apm: []
{% endif -%}
  mcp: []
includes: auto
scripts: {}
