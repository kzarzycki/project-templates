{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "timezone": "UTC",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "description": "Routine: refreshes the lock files once a week, so a package pinned only there (a transitive one in uv.lock) updates too.",
    "enabled": true,
    "schedule": ["* 0-5 * * 1"],
    "automerge": true
  },
{% if include_agent_layer %}
  "customManagers": [
    {
      "customType": "regex",
      "description": "apm.yml git packages pinned to a release tag <package>-vX.Y.Z",
      "managerFilePatterns": ["/(^|/)apm\\.yml$/"],
      "matchStrings": [
        "-\\s+git:\\s*(?<packageName>[\\w.-]+/[\\w.-]+)/(?<package>[\\w.-]+)\\s*\\n\\s*ref:\\s*[\\w.-]+?-v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "{{ '{{{packageName}}}/{{{package}}}' }}",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "{{ '^{{{package}}}-v(?<version>\\\\d+\\\\.\\\\d+\\\\.\\\\d+)$' }}"
    }
  ],
{% endif %}
  "packageRules": [
    {
      "description": "Routine: patch and minor updates of tools, libraries and actions, one group a week, landed on the gates.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "tools and libraries",
      "schedule": ["* 0-5 * * 1"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Verify: a major update gets its own draft PR, which an agent reviews before it lands.",
      "matchUpdateTypes": ["major"],
      "addLabels": ["verify"],
      "draftPR": true,
      "automerge": false
    },
    {
      "description": "Verify: the template{% if include_agent_layer %} and the agent packages{% endif %}, one draft PR a night, which an agent reviews before it lands.",
      "matchManagers": ["copier"{% if include_agent_layer %}, "custom.regex"{% endif %}],
      "groupName": "template{% if include_agent_layer %} and agent packages{% endif %}",
      "schedule": ["* 0-5 * * *"],
      "minimumReleaseAge": null,
      "addLabels": ["verify"],
      "draftPR": true,
      "automerge": false,
      "ignoreScripts": false{% if include_agent_layer %},
      "postUpgradeTasks": {
        "commands": ["mise run agent:sync -- --refresh"],
        "executionMode": "branch"
      }{% endif %}
    },
    {
      "description": "Copier records gh:owner/repo, which Renovate's git-tags lookup cannot read.",
      "matchManagers": ["copier"],
      "matchPackageNames": ["/^gh:/"],
      "overridePackageName": "{{ "https://github.com/{{{replace '^gh:' '' packageName}}}" }}"
    }
  ]
}
