{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
{%- if include_agent_layer %}
    "github>kzarzycki/agent-skills//renovate/stable",
{%- endif %}
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "UTC",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "description": "Routine: refreshes the lock files once a week, so a package pinned only there (a transitive one in uv.lock) updates too.",
    "enabled": true,
    "schedule": ["* 0-5 * * 1"],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Routine: patch and minor updates of tools, libraries and actions, one group a week, landed on the gates.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "tools and libraries",
      "schedule": ["* 0-5 * * 1"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Verify: a major update gets its own draft PR, which an agent reviews before it lands.",
      "matchUpdateTypes": ["major"],
      "addLabels": ["verify"],
      "draftPR": true,
      "automerge": false
    },
    {%- set verify_groups = [("template", "copier", "")] + ([("agent packages", "custom.regex", ""), ("agent packages", "mise", ', "matchDepNames": ["github:microsoft/apm"]')] if include_agent_layer else []) %}
    {%- for group, manager, extra in verify_groups %}
    {
      "description": "Verify: the {{ group }}, one draft PR a night, which an agent reviews before it lands.{% if include_agent_layer and manager == 'mise' %} The apm pin in mise.toml moves in this group, never on its own in the tools group: a new apm can break the pack for claude and codex consumers until the pack ships its fix, so it moves only with the pack versions it was tested against.{% elif include_agent_layer %} Its own branch: copier refuses a tree another manager already changed.{% endif %}",
      "matchManagers": ["{{ manager }}"]{{ extra }},
      "groupName": "{{ group }}",
      "schedule": ["* 0-5 * * *"],
      "minimumReleaseAge": null,
      "addLabels": ["verify"],
      "draftPR": true,
      "automerge": false,
      "ignoreScripts": false{% if include_agent_layer %},
      "postUpgradeTasks": {
        "commands": ["mise run agent:sync -- --refresh"],
        "executionMode": "branch"
      }{% endif %}
    },
    {%- endfor %}
    {
      "description": "mise pins conda tools by bare name and installs them from conda-forge; anaconda.org names a package by channel.",
      "matchManagers": ["mise"],
      "matchDatasources": ["conda"],
      "matchPackageNames": ["!/\\//"],
      "overridePackageName": "{{ 'conda-forge/{{{packageName}}}' }}"
    },
    {
      "description": "Copier records gh:owner/repo, which Renovate's git-tags lookup cannot read.",
      "matchManagers": ["copier"],
      "matchPackageNames": ["/^gh:/"],
      "overridePackageName": "{{ "https://github.com/{{{replace '^gh:' '' packageName}}}" }}"
    }
  ]
}
