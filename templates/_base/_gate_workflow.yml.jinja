# The loop's merge gate: the proof each loop step leaves (mise run gate). It reruns when
# an approval label or the PR body changes. The project's own CI is separate: here each
# of its checks is its own status, and the loop's local `mise run gate merge` needs them green.
name: Gate
on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review, edited, labeled, unlabeled]

permissions: {}

concurrency:
  group: {% raw %}gate-${{ github.event.pull_request.number }}{% endraw %}
  cancel-in-progress: true

jobs:
  gate:
    if: {% raw %}${{ !github.event.pull_request.draft && github.event.pull_request.user.login != 'dependabot[bot]' }}{% endraw %}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      issues: read
      pull-requests: read
      checks: read
      statuses: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: jdx/mise-action@c2a87611a18de5b3828c5652fe268e992400cb5c # v4.3.0
        with:
          install: false # the gate needs only python3 and gh, which the runner has
      - name: Gate
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          PR: {% raw %}${{ github.event.pull_request.number }}{% endraw %}
          MISE_TASK_RUN_AUTO_INSTALL: "false"
        run: mise run gate merge "$PR"
