{% set leaf_pins_python = project_type in ['software/python', 'data/dbt'] or (project_type == 'ai/mcp' and (language | default('')) == 'python') -%}
{% if include_agent_layer and not leaf_pins_python -%}
python = "3.14"
{% endif -%}
{% if include_agent_layer -%}
{% set apm_version = "0.33.0" %}
{% set vendored = agent_layer_mode == "vendored" -%}
{# The files sync writes; in vendored mode the root CLAUDE.md and AGENTS.md are the project's. -#}
{% set frozen_paths -%}
{% if vendored %}apm.yml apm.lock.yaml .agents .claude .codex{% else %}\
    apm.yml apm.lock.yaml .apm AGENTS.md CLAUDE.md \
    ':(glob)**/AGENTS.md' ':(glob)**/CLAUDE.md' \
    .agents .claude .codex .github/instructions{% endif %}
{%- endset -%}
"github:microsoft/apm" = "{{ apm_version }}"
{% endif -%}
{% if include_agent_layer and include_fnox -%}
fnox = "1.30.0"
{% endif -%}
{% if include_agent_layer %}

[tasks."agent:sync"]
alias = "agent-sync"
description = "Converge project-owned coding agent configuration."
usage = '''
flag "--refresh" help="Resolve available dependency releases before convergence"
flag "--frozen" help="Verify the committed lock and generated coding agent state"
'''
run = """
if [ "${usage_refresh:-false}" = true ] && [ "${usage_frozen:-false}" = true ]; then
  echo "error: --refresh and --frozen cannot be combined" >&2
  exit 2
fi
mode=default
if [ "${usage_refresh:-false}" = true ]; then mode=refresh; fi
if [ "${usage_frozen:-false}" = true ]; then mode=frozen; fi
command -v apm >/dev/null || { echo "error: apm {{ apm_version }} is required; run 'mise install'" >&2; exit 127; }
command -v python3 >/dev/null || { echo "error: python3 is required; run 'mise install'" >&2; exit 127; }
{% if include_fnox -%}
command -v fnox >/dev/null || { echo "error: fnox 1.30.0 is required; run 'mise install'" >&2; exit 127; }
{% endif -%}
agent_targets="$(python3 -c '
import re
from pathlib import Path

targets = []
in_targets = False
for line in Path("apm.yml").read_text().splitlines():
    if not in_targets:
        in_targets = re.fullmatch(r"targets:\\s*(?:#.*)?", line) is not None
        continue
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        continue
    match = re.fullmatch(r"-\\s*([a-z0-9-]+)(?:\\s+#.*)?", stripped)
    if match is None:
        break
    targets.append(match.group(1))
print(",".join(targets))
')"
if [ -z "$agent_targets" ]; then
  echo "error: apm.yml must activate at least one coding agent target" >&2
  exit 2
fi
{% if vendored -%}
# The deployed skills are committed files anyone may edit: an install would silently revert an
# edit, so sync refuses until agent:intake has taken each one in.
mise run --skip-tools agent:intake -- --check
{% endif -%}
if [ "$mode" = frozen ]; then
  frozen_changes="$(git status --porcelain=v1 --untracked-files=all -- {{ frozen_paths }})"
  if [ -n "$frozen_changes" ]; then
    echo "error: frozen agent configuration changed:" >&2
    echo "$frozen_changes" >&2
    echo "run 'mise run agent:sync' and commit the resulting agent configuration" >&2
    exit 1
  fi
fi
case "$mode" in
  default) apm install --target "$agent_targets" ;;
  refresh) apm update --yes --target "$agent_targets" ;;
  frozen)
    apm install --frozen --target "$agent_targets"
    apm audit --ci --no-policy
    ;;
esac
{% if vendored -%}
apm prune
# Every edit was ported or dropped, and the install restored the dropped ones.
rm -rf .agent-intake
{% else -%}
apm compile --clean
apm compile --validate
{% endif -%}
apm audit --ci --no-policy
# Add native-output validation for every implemented coding agent here.
if [ -f .mcp.json ]; then python3 -m json.tool .mcp.json >/dev/null; fi
if [ -f .codex/config.toml ]; then python3 -c 'import tomllib; tomllib.load(open(".codex/config.toml", "rb"))'; fi
{% if include_fnox -%}
fnox check --all --non-interactive --if-missing error
{% endif -%}
if [ "$mode" = frozen ]; then
  frozen_changes="$(git status --porcelain=v1 --untracked-files=all -- {{ frozen_paths }})"
  if [ -n "$frozen_changes" ]; then
    echo "error: frozen agent configuration changed:" >&2
    echo "$frozen_changes" >&2
    echo "run 'mise run agent:sync' and commit the resulting agent configuration" >&2
    exit 1
  fi
fi
"""
{% if vendored -%}

[tasks."agent:intake"]
description = "Turns each local edit of a deployed skill file into a patch against the pack's copy, to port into the pack or drop."
usage = """
flag "--refresh" help="Take the newer compatible pack first; a patch the release already carries resolves itself"
flag "--check" help="Write nothing: exit 1 while a drifted file has no intake or a patch is unresolved (agent:sync runs this)"
"""
# A patch is resolved by porting it into the pack and taking that release with --refresh, or by
# deleting it: the next agent:sync then restores the pack's copy.
run = """
command -v apm >/dev/null || { echo "error: apm {{ apm_version }} is required; run 'mise install'" >&2; exit 127; }
command -v python3 >/dev/null || { echo "error: python3 is required; run 'mise install'" >&2; exit 127; }
mode=intake
if [ "${usage_refresh:-false}" = true ]; then mode=refresh; fi
if [ "${usage_check:-false}" = true ]; then mode=check; fi
python3 - "$mode" <<'PY'
import base64
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

mode = sys.argv[1]
INTAKE = Path(".agent-intake")
# Each line is "<sha256 of the edited file>  <path>": the edits intake has taken in.
LEDGER = INTAKE / "intaken"
# Per edited file: its bytes ("edit", base64, null for a deleted file), on disk before apm update can
# overwrite them, and the hash of what the update deployed ("deployed", null until it finished).
# Its presence means a --refresh did not finish: the next intake puts the edits back.
SAVED = INTAKE / "saved.json"


def fail(message):
    print(f"agent:intake: {message}", file=sys.stderr)
    sys.exit(1)


def drifted():
    if not Path("apm.lock.yaml").is_file():
        return []
    audit = subprocess.run(["apm", "audit", "--ci", "--no-policy", "-f", "json"], capture_output=True, text=True)
    try:
        report = json.loads(audit.stdout)
    except json.JSONDecodeError:
        fail(f"apm audit gave no JSON report (exit {audit.returncode}):\\n{audit.stderr}")
    return sorted({entry["path"] for entry in (report.get("drift") or {}).get("drift", [])})


def content(path):
    return path.read_bytes() if path.is_file() else None


def digest(path):
    data = content(path)
    return "absent" if data is None else hashlib.sha256(data).hexdigest()


def ledger():
    lines = LEDGER.read_text().splitlines() if LEDGER.is_file() else []
    return {path: sha for sha, path in (line.split("  ", 1) for line in lines if line)}


def patches():
    if not INTAKE.is_dir():
        return []
    return sorted(patch.relative_to(INTAKE).as_posix().removesuffix(".patch") for patch in INTAKE.rglob("*.patch"))


def save(entries):
    INTAKE.mkdir(exist_ok=True)
    encoded = {path: {**entry, "edit": None if entry["edit"] is None else base64.b64encode(entry["edit"]).decode()}
               for path, entry in entries.items()}
    staged = INTAKE / "saved.json.tmp"
    with staged.open("w") as file:
        json.dump(encoded, file)
        file.flush()
        os.fsync(file.fileno())
    os.replace(staged, SAVED)


def saved():
    if not SAVED.is_file():
        return {}
    return {path: {**entry, "edit": None if entry["edit"] is None else base64.b64decode(entry["edit"])}
            for path, entry in json.loads(SAVED.read_text()).items()}


def put(target, data):
    if data is None:
        target.unlink(missing_ok=True)
    else:
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(data)


# Puts each saved edit back over the bytes the update deployed, and only over those: a file that
# differs from them (or whose update never finished) may hold a newer edit, so both versions stay
# on disk and saved.json stays until each is resolved.
def recover():
    entries = saved()
    conflicts = []
    for path, entry in entries.items():
        target, kept = Path(path), INTAKE / f"{path}.saved"
        if content(target) == entry["edit"]:
            pass
        elif entry["deployed"] is not None and digest(target) == entry["deployed"]:
            put(target, entry["edit"])
        elif entry.get("kept") and not kept.exists():
            pass  # its saved copy was deleted: the file as it is now wins
        else:
            if not entry.get("kept"):
                put(kept, entry["edit"] or b"")
                entry["kept"] = True
            conflicts.append(path)
            continue
        kept.unlink(missing_ok=True)
    if conflicts:
        save({path: entries[path] for path in conflicts})
        for path in conflicts:
            saved_edit = (f"the interrupted run's edit deletes it ({INTAKE}/{path}.saved marks it): to keep the deletion, "
                          f"delete both {path} and the marker"
                          if entries[path]["edit"] is None else f"the interrupted run's edit is {INTAKE}/{path}.saved")
            print(f"agent:intake: {path} changed after an interrupted --refresh: the file keeps its current bytes; {saved_edit}",
                  file=sys.stderr)
        fail("keep one version of each: put the saved edit in place of the file (or port it into the pack first), "
             "or delete the .saved file to keep the current one; then run 'mise run agent:intake' again")
    SAVED.unlink(missing_ok=True)
    return list(entries)


def write_patches(paths):
    diffs = {}
    if paths:
        # The pack's copy: what an install would deploy, written to a scratch root so the tree keeps its edits.
        pristine = Path(tempfile.mkdtemp(prefix="agent-intake-"))
        try:
            shutil.copy("apm.lock.yaml", pristine)
            install = subprocess.run(["apm", "install", "--frozen", "--root", str(pristine)], capture_output=True, text=True)
            if install.returncode != 0:
                fail(f"could not install the pack's copy:\\n{install.stdout}{install.stderr}")
            for path in paths:
                old, new = pristine / path, Path(path)
                diff = subprocess.run(
                    ["diff", "-u", "--label", f"a/{path}", "--label", f"b/{path}",
                     str(old) if old.is_file() else "/dev/null", str(new) if new.is_file() else "/dev/null"],
                    capture_output=True,
                )
                if diff.returncode not in (0, 1):
                    fail(f"diff of {path} failed:\\n{diff.stderr.decode()}")
                diffs[path] = diff.stdout
        finally:
            shutil.rmtree(pristine, ignore_errors=True)
    # The old patches go only once every new one is in hand.
    for path in patches():
        (INTAKE / f"{path}.patch").unlink()
    LEDGER.unlink(missing_ok=True)
    for path, diff in diffs.items():
        patch = INTAKE / f"{path}.patch"
        patch.parent.mkdir(parents=True, exist_ok=True)
        patch.write_bytes(diff)
    if diffs:
        LEDGER.write_text("".join(f"{digest(Path(path))}  {path}\\n" for path in diffs))
    elif not SAVED.exists():
        shutil.rmtree(INTAKE, ignore_errors=True)


def report():
    remaining = patches()
    for path in remaining:
        print(f"{INTAKE}/{path}.patch: port it into the pack, or delete it to drop the edit (the next agent:sync restores the pack's copy)")
    if remaining:
        sys.exit(1)
    print("agent:intake: no unresolved patch")


if mode == "check":
    if SAVED.is_file():
        print(f"agent:sync: {SAVED} holds edits an interrupted 'agent:intake --refresh' saved", file=sys.stderr)
        fail("run 'mise run agent:intake' to put them back, then port or drop each patch")
    seen = ledger()
    unseen = [path for path in drifted() if seen.get(path) != digest(Path(path))]
    for path in unseen:
        print(f"agent:sync: {path} differs from the pack's copy; an install would revert it", file=sys.stderr)
    for path in patches():
        print(f"agent:sync: {INTAKE}/{path}.patch is unresolved", file=sys.stderr)
    if unseen or patches():
        fail("run 'mise run agent:intake', then port or drop each patch")
    sys.exit(0)

if SAVED.is_file():
    print(f"agent:intake: put back the edits an interrupted --refresh saved: {', '.join(recover())}")
edits = drifted()
write_patches(edits)
if mode == "refresh":
    if edits:
        save({path: {"edit": content(Path(path)), "deployed": None} for path in edits})
    try:
        updated = subprocess.run(["apm", "update", "--yes"]).returncode == 0
    except KeyboardInterrupt:
        updated = False
    entries = saved()
    if not updated:
        # This run's own update wrote the bytes on disk: put each edit back over them.
        for path, entry in entries.items():
            put(Path(path), entry["edit"])
        SAVED.unlink(missing_ok=True)
        fail("apm update failed; the edits are put back and the patches are saved")
    for path, entry in entries.items():
        entry["deployed"] = digest(Path(path))
        if content(Path(path)) == entry["edit"]:
            print(f"resolved: the release carries the edit to {path}")
    if entries:
        save(entries)
        recover()
    write_patches(drifted())
report()
PY
"""
{% endif %}
# Launcher tasks are coding-agent-specific. Add one only when the coding agent
# has a stable CLI.
[tasks."agent:claude"]
alias = "agent-claude"
{% if include_fnox -%}
description = "Launch Claude Code with this repository's machine bindings."
{% else -%}
description = "Launch Claude Code."
{% endif -%}
run = """
{% if include_fnox -%}
command -v fnox >/dev/null || { echo "error: fnox 1.30.0 is required; run 'mise install'" >&2; exit 127; }
{% endif -%}
command -v claude >/dev/null || { echo "error: claude is required; install Claude Code and add 'claude' to PATH" >&2; exit 127; }
{% if include_fnox -%}
fnox exec --non-interactive --if-missing error -- claude
{% else -%}
claude
{% endif -%}
"""

[tasks."agent:codex"]
alias = "agent-codex"
{% if include_fnox -%}
description = "Launch Codex with this repository's machine bindings."
{% else -%}
description = "Launch Codex."
{% endif -%}
run = """
{% if include_fnox -%}
command -v fnox >/dev/null || { echo "error: fnox 1.30.0 is required; run 'mise install'" >&2; exit 127; }
{% endif -%}
command -v codex >/dev/null || { echo "error: codex is required; install Codex and add 'codex' to PATH" >&2; exit 127; }
{% if include_fnox -%}
fnox exec --non-interactive --if-missing error -- codex
{% else -%}
codex
{% endif -%}
"""
{% endif -%}
