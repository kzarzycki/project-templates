{% set leaf_pins_python = project_type in ['software/python', 'data/dbt'] or (project_type == 'ai/mcp' and (language | default('')) == 'python') -%}
{% if include_agent_layer and not leaf_pins_python -%}
python = "3.14"
{% endif -%}
{% if include_agent_layer -%}
{% set apm_version = "0.30.0" %}
"github:microsoft/apm" = "{{ apm_version }}"
{% endif -%}
{% if include_agent_layer and include_fnox -%}
fnox = "1.30.0"
{% endif -%}
{% if include_agent_layer %}

[tasks.agent-sync]
description = "Converge project-owned coding agent configuration."
usage = '''
flag "--refresh" help="Resolve available dependency releases before convergence"
flag "--frozen" help="Verify the committed lock and generated coding agent state"
'''
run = """
if [ "${usage_refresh:-false}" = true ] && [ "${usage_frozen:-false}" = true ]; then
  echo "error: --refresh and --frozen cannot be combined" >&2
  exit 2
fi
mode=default
if [ "${usage_refresh:-false}" = true ]; then mode=refresh; fi
if [ "${usage_frozen:-false}" = true ]; then mode=frozen; fi
command -v apm >/dev/null || { echo "error: apm {{ apm_version }} is required; run 'mise install'" >&2; exit 127; }
command -v python3 >/dev/null || { echo "error: python3 is required; run 'mise install'" >&2; exit 127; }
{% if include_fnox -%}
command -v fnox >/dev/null || { echo "error: fnox 1.30.0 is required; run 'mise install'" >&2; exit 127; }
{% endif -%}
agent_targets="$(python3 -c '
import re
from pathlib import Path

targets = []
in_targets = False
for line in Path("apm.yml").read_text().splitlines():
    if not in_targets:
        in_targets = re.fullmatch(r"targets:\\s*(?:#.*)?", line) is not None
        continue
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        continue
    match = re.fullmatch(r"-\\s*([a-z0-9-]+)(?:\\s+#.*)?", stripped)
    if match is None:
        break
    targets.append(match.group(1))
print(",".join(targets))
')"
if [ -z "$agent_targets" ]; then
  echo "error: apm.yml must activate at least one coding agent target" >&2
  exit 2
fi
if [ "$mode" = frozen ]; then
  frozen_changes="$(git status --porcelain=v1 --untracked-files=all -- \
    apm.yml apm.lock.yaml .apm AGENTS.md CLAUDE.md \
    ':(glob)**/AGENTS.md' ':(glob)**/CLAUDE.md' \
    .agents .claude .codex .github/instructions)"
  if [ -n "$frozen_changes" ]; then
    echo "error: frozen agent configuration changed:" >&2
    echo "$frozen_changes" >&2
    echo "run 'mise run agent-sync' and commit the resulting agent configuration" >&2
    exit 1
  fi
fi
case "$mode" in
  default) apm install --target "$agent_targets" ;;
  refresh) apm update --yes --target "$agent_targets" ;;
  frozen)
    apm install --frozen --target "$agent_targets"
    apm audit --ci --no-policy
    ;;
esac
apm compile --clean
apm compile --validate
apm audit --ci --no-policy
# Add native-output validation for every implemented coding agent here.
if [ -f .mcp.json ]; then python3 -m json.tool .mcp.json >/dev/null; fi
if [ -f .codex/config.toml ]; then python3 -c 'import tomllib; tomllib.load(open(".codex/config.toml", "rb"))'; fi
{% if include_fnox -%}
fnox check --all --non-interactive --if-missing error
{% endif -%}
if [ "$mode" = frozen ]; then
  frozen_changes="$(git status --porcelain=v1 --untracked-files=all -- \
    apm.yml apm.lock.yaml .apm AGENTS.md CLAUDE.md \
    ':(glob)**/AGENTS.md' ':(glob)**/CLAUDE.md' \
    .agents .claude .codex .github/instructions)"
  if [ -n "$frozen_changes" ]; then
    echo "error: frozen agent configuration changed:" >&2
    echo "$frozen_changes" >&2
    echo "run 'mise run agent-sync' and commit the resulting agent configuration" >&2
    exit 1
  fi
fi
"""

# Launcher tasks are coding-agent-specific. Add one only when the coding agent
# has a stable CLI.
[tasks.agent-claude]
{% if include_fnox -%}
description = "Launch Claude Code with this repository's machine bindings."
{% else -%}
description = "Launch Claude Code."
{% endif -%}
run = """
{% if include_fnox -%}
command -v fnox >/dev/null || { echo "error: fnox 1.30.0 is required; run 'mise install'" >&2; exit 127; }
{% endif -%}
command -v claude >/dev/null || { echo "error: claude is required; install Claude Code and add 'claude' to PATH" >&2; exit 127; }
{% if include_fnox -%}
fnox exec --non-interactive --if-missing error -- claude
{% else -%}
claude
{% endif -%}
"""

[tasks.agent-codex]
{% if include_fnox -%}
description = "Launch Codex with this repository's machine bindings."
{% else -%}
description = "Launch Codex."
{% endif -%}
run = """
{% if include_fnox -%}
command -v fnox >/dev/null || { echo "error: fnox 1.30.0 is required; run 'mise install'" >&2; exit 127; }
{% endif -%}
command -v codex >/dev/null || { echo "error: codex is required; install Codex and add 'codex' to PATH" >&2; exit 127; }
{% if include_fnox -%}
fnox exec --non-interactive --if-missing error -- codex
{% else -%}
codex
{% endif -%}
"""
{% if loop_enabled %}

[tasks.gate]
description = "The proof gate: each loop step left its proof. The loop, the pre-push hook and CI run it."
usage = '''
arg "<point>" help="build or merge"
arg "[pr]" help="the PR number; default: this branch's PR"
'''
# Add the project's own checks as more lines; the gate stops at the first that fails.
# ponytail: the path is the codex target's copy; without codex, point it at .claude/skills.
run = [
  'test -f .agents/skills/engineering-loop/scripts/gate.py || { echo "gate: the engineering-loop skill is not installed; run mise run agent-sync and commit its output" >&2; exit 1; }',
  'python3 .agents/skills/engineering-loop/scripts/gate.py check "${usage_point}" ${usage_pr:-}',
]

[tasks.merge-queue]
description = "Land main through a merge queue: apply .github/rulesets/main.json to this repo on GitHub and allow auto-merge."
# The ruleset requires the CI and gate jobs by name: rename a job, update the ruleset, rerun this.
# The first run saves what it changes in .git/merge-queue/: the previous allow_auto_merge, and the
# previous `main` ruleset it overwrites (or a note that it created one). restore.sh there puts it
# back: PUT the saved ruleset, or DELETE the one it created, then the saved auto-merge value.
run = '''
command -v gh >/dev/null || { echo "error: gh is required; install the GitHub CLI and run 'gh auth login'" >&2; exit 127; }
saved="$(git rev-parse --git-dir)/merge-queue"
mkdir -p "$saved"
# A snapshot is published only after its read succeeds, so a failed read never passes for one.
if [ ! -f "$saved/allow_auto_merge" ]; then
  gh api 'repos/{owner}/{repo}' --jq .allow_auto_merge > "$saved/allow_auto_merge.tmp"
  mv "$saved/allow_auto_merge.tmp" "$saved/allow_auto_merge"
fi
id="$(gh api --paginate 'repos/{owner}/{repo}/rulesets' --jq '.[] | select(.source_type == "Repository" and .name == "main") | .id')"
if [ -n "$id" ]; then
  # A rerun keeps the first save: the ruleset is this task's own by then.
  # A ruleset counts as this task's own only while its id is the one the task created.
  if [ "$(cat "$saved/created" 2>/dev/null)" != "$id" ]; then rm -f "$saved/created"; fi
  if [ ! -f "$saved/ruleset.json" ] && [ ! -f "$saved/created" ]; then
    gh api "repos/{owner}/{repo}/rulesets/$id" \
      --jq '{name, target, enforcement, conditions, rules, bypass_actors}' > "$saved/ruleset.json.tmp"
    mv "$saved/ruleset.json.tmp" "$saved/ruleset.json"
  fi
  gh api -X PUT "repos/{owner}/{repo}/rulesets/$id" --input .github/rulesets/main.json --jq .id
else
  id="$(gh api -X POST 'repos/{owner}/{repo}/rulesets' --input .github/rulesets/main.json --jq .id)"
  echo "$id" > "$saved/created"
  rm -f "$saved/ruleset.json"
fi
# restore.sh stops at the first failed call, so a failed ruleset restore never reports success.
echo "set -e" > "$saved/restore.sh"
if [ -f "$saved/ruleset.json" ]; then
  echo "gh api -X PUT 'repos/{owner}/{repo}/rulesets/$id' --input '$saved/ruleset.json'" >> "$saved/restore.sh"
else
  echo "gh api -X DELETE 'repos/{owner}/{repo}/rulesets/$id'" >> "$saved/restore.sh"
fi
echo "gh api -X PATCH 'repos/{owner}/{repo}' -F allow_auto_merge=$(cat "$saved/allow_auto_merge")" >> "$saved/restore.sh"
# After a full restore the snapshots are spent: the next apply records its own starting state.
echo "rm -rf '$saved'" >> "$saved/restore.sh"
gh api -X PATCH 'repos/{owner}/{repo}' -F allow_auto_merge=true --jq '"allow_auto_merge: \(.allow_auto_merge)"'
echo "ruleset $id applied; to undo: sh '$saved/restore.sh'"
'''
{% endif -%}
{% endif -%}
