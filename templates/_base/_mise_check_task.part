[tasks.check]
description = "The gate: the toolchain's tests and checks, then every pre-commit hook. CI runs this task."
# The including leaf sets check_commands. Lint and format run as pre-commit hooks.
run = """
{{ check_commands }}pre-commit run --all-files --show-diff-on-failure
{% if include_agent_layer -%}
if [ -f apm.lock.yaml ]; then
  # The outer `mise run check` already provided the tools.
  mise run --skip-tools agent-sync -- --frozen
else
  # ponytail: an unsynced project has no lock to verify; the first committed sync arms this.
  echo "check: no apm.lock.yaml yet, agent configuration not verified; run 'mise run agent-sync' and commit its output" >&2
fi
{% endif -%}
"""