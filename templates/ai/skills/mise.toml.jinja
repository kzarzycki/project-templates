[tools]
{% include "templates/_base/_mise_tools.part" -%}
{% include "templates/_base/_mise_agent_tasks.part" %}
{% include "templates/_base/_mise_tasks.part" %}

[tasks."test:fast"]
alias = ["test", "validate"]
description = "Validates the skill package: SKILL.md frontmatter and .claude-plugin/plugin.json."
run = "python3 scripts/validate-skill.py"

[tasks."test:unit"]
description = "Runs test:fast: this project has one test tier."
depends = ["test:fast"]

[tasks."test:changed"]
description = "Runs test:fast: this project has no per-change test selection."
depends = ["test:fast"]

[tasks."check:unit"]
description = "Runs test:unit in a host gate slot (scripts/gate-slot); a skill package measures no coverage."
# The outer mise run already provided the tools.
run = "scripts/gate-slot mise run --skip-tools test:unit"

[tasks."setup:dev"]
alias = "bootstrap"
description = "Installs the git hooks on a fresh checkout."
run = "pre-commit install --allow-missing-config --install-hooks"
