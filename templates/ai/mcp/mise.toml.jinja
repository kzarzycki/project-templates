[tools]
{% include "templates/_lang/" ~ language ~ "/_mise_tools.part" -%}
{% include "templates/_base/_mise_tools.part" -%}
{% include "templates/_base/_mise_agent_tasks.part" %}
{% include "templates/_base/_mise_tasks.part" %}

{% include "templates/_lang/" ~ language ~ "/_mise_tasks.part" %}{% if include_example %}
[tasks."test:smoke"]
alias = "smoke"
description = "Builds the MCP server and checks it answers (scripts/smoke)."
{% if language == 'python' %}run = "uv run python scripts/smoke_server.py"
{% else %}run = "node scripts/smoke-server.mjs"
{% endif %}
[tasks."check:smoke"]
description = "Runs test:smoke: the MCP server builds and answers."
depends = ["test:smoke"]
{% endif %}