{% include "templates/_base/_ci_header.yml.jinja" %}
jobs:
  build:
    runs-on: {{ ci_runner }}
    steps:
{% include "templates/_base/_ci_checkout.yml.jinja" -%}
{% if language == 'node' %}{% include "templates/_lang/node/_ci_setup.yml.jinja" -%}
{% endif %}{% include "templates/_base/_ci_precommit.yml.jinja" -%}
{% include "templates/_lang/" ~ language ~ "/_ci_steps.yml.jinja" %}
{% if language == 'python' %}      - name: MCP server smoke check
        run: uv run python scripts/smoke_server.py
{% endif %}{% if language == 'node' %}      - name: MCP server smoke check
        run: node scripts/smoke-server.mjs
{% endif %}