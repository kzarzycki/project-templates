[tools]
{% include "templates/_lang/java/_mise_tools.part" -%}
pre-commit = "4.6.0"
{% include "templates/_base/_mise_agent_tasks.part" %}
{% set check_commands %}{% include "templates/_lang/java/_check.part" %}{% endset -%}
{% include "templates/_base/_mise_check_task.part" %}

[tasks.test]
run = "./gradlew test"

[tasks.lint]
run = "./gradlew spotlessCheck"

[tasks.fmt]
run = "./gradlew spotlessApply"

[tasks.bootstrap]
run = "./gradlew build && pre-commit install --install-hooks"

[hooks]
postinstall = "pre-commit install --install-hooks"
