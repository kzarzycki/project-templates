[tools]
{% include "templates/_lang/node/_mise_tools.part" -%}
pre-commit = "4.6.0"
{% include "templates/_base/_mise_agent_tasks.part" %}
{% set check_commands %}{% include "templates/_lang/node/_check.part" %}{% endset -%}
{% include "templates/_base/_mise_check_task.part" %}

[tasks.test]
run = "npm test"

[tasks.lint]
run = "npm run check"

[tasks.fmt]
run = "npm run check"

[tasks.bootstrap]
run = "npm install && pre-commit install --install-hooks"

[hooks]
postinstall = "pre-commit install --install-hooks"
