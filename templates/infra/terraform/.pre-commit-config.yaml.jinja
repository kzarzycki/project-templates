# Managed by Copier — edit the template, then `copier update`.
default_install_hook_types: [pre-commit, commit-msg, pre-push]
{% if include_mise -%}
# A hook runs at the pre-commit stage unless it names its stage.
default_stages: [pre-commit]
repos:
{% include "templates/_base/_precommit_hooks.yml.jinja" %}
      - id: lint:terraform-fmt
        name: lint:terraform-fmt
        entry: mise run lint:terraform-fmt --
        language: system
      # tflint lints the modules from their directories, so the hook passes it no files. terraform
      # validate needs `terraform init` with provider downloads, too heavy for a commit: CI runs it.
      - id: lint:tflint
        name: lint:tflint
        entry: mise run lint:tflint --
        language: system
        pass_filenames: false
{% else -%}
# Run locally: pre-commit run --all-files   ·   Update pins: pre-commit autoupdate
repos:
{% include "templates/_base/_precommit.yml.jinja" %}
  # terraform_validate is intentionally omitted — it needs `terraform init` with
  # provider downloads, too heavy/fragile for a commit hook. CI runs it.
  - repo: https://github.com/antonbabenko/pre-commit-terraform
    rev: v1.108.0
    hooks:
      - id: terraform_fmt
      - id: terraform_tflint
{% endif -%}
