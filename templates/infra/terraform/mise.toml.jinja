[tools]
terraform = "{{ terraform_version }}"
tflint = "0.63.1"
{% include "templates/_base/_mise_tools.part" -%}
{% include "templates/_base/_mise_agent_tasks.part" %}
{% include "templates/_base/_mise_tasks.part" %}

[tasks."lint:terraform-fmt"]
description = "Formats the Terraform files (terraform fmt); fixes in place."
run = 'scripts/files-or-repo --fixer --only "\.(tf|tfvars|tftest\.hcl)$" terraform fmt --'

[tasks."lint:terraform-validate"]
alias = "validate"
description = "Validates the configuration offline (no backend; init fetches only the providers it declares)."
run = "terraform init -backend=false -input=false && terraform validate"

[tasks."lint:tflint"]
description = "Lints the Terraform modules with tflint."
run = "tflint --init && tflint --recursive"

[tasks."test:fast"]
description = "Runs the Terraform tests (terraform test, offline: no backend)."
run = "terraform init -backend=false -input=false && terraform test"

[tasks."test:unit"]
description = "Runs test:fast: this project has one test tier."
depends = ["test:fast"]

[tasks."test:changed"]
description = "Runs test:fast: this project has no per-change test selection."
depends = ["test:fast"]

[tasks."check:unit"]
description = "Runs test:unit; Terraform measures no coverage."
depends = ["test:unit"]

[tasks."setup:dev"]
alias = "bootstrap"
description = "Installs the git hooks on a fresh checkout."
run = "pre-commit install --install-hooks"

{% if include_fnox -%}
# Provider credentials come from the fnox profile "infra" (see fnox.toml), so a coding
# agent launched with the default profile never holds cloud tokens.
[tasks.plan]
description = "Show the plan without applying."
run = 'fnox exec -P infra --if-missing error -- sh -c "terraform init -input=false && terraform plan"'

[tasks.apply]
description = "Apply the plan."
run = 'fnox exec -P infra --if-missing error -- sh -c "terraform init -input=false && terraform apply"'
{% else -%}
[tasks.plan]
description = "Show the plan without applying."
run = "terraform init -input=false && terraform plan"

[tasks.apply]
description = "Apply the plan."
run = "terraform init -input=false && terraform apply"
{% endif -%}
