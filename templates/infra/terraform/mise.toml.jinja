[tools]
terraform = "{{ terraform_version }}"
tflint = "0.63.1"
{% include "templates/_base/_mise_tools.part" -%}
{% include "templates/_base/_mise_agent_tasks.part" %}
{% include "templates/_base/_mise_tasks.part" %}

[tasks."lint:terraform-fmt"]
description = "Formats the Terraform files (terraform fmt); fixes in place."
run = 'scripts/files-or-repo --fixer --only "\.(tf|tfvars|tftest\.hcl)$" terraform fmt --'

[tasks."lint:terraform-validate"]
alias = "validate"
description = "Validates every root module offline (no backend; init fetches only the providers it declares)."
# A root module is a directory with a tracked *.tf file outside a modules/ tree; the child modules
# are validated through the roots that call them. TF_ROOT_MODULES, set under [env], replaces the
# list (space-separated directories). Its own TF_DATA_DIR, so a module already initialized against
# a remote backend validates with no credentials.
# ponytail: a directory name with a space is not supported; quote the loop when one appears.
run = '''
roots="${TF_ROOT_MODULES:-$(git ls-files -- '*.tf' | sed 's#[^/]*$##; s#/$##; s#^$#.#' | sort -u | grep -Ev '(^|/)modules(/|$)')}"
[ -n "$roots" ] || { echo "lint:terraform-validate: no Terraform root module"; exit 0; }
for dir in $roots; do
  echo "== $dir"
  TF_DATA_DIR=.terraform/offline terraform -chdir="$dir" init -backend=false -input=false >/dev/null || exit 1
  TF_DATA_DIR=.terraform/offline terraform -chdir="$dir" validate || exit 1
done
'''

[tasks."lint:tflint"]
description = "Lints the Terraform modules with tflint."
run = "tflint --init && tflint --recursive"

[tasks."test:fast"]
alias = "test"
description = "Runs the Terraform tests (terraform test, offline: no backend) in every module that has one."
# terraform test runs from the module directory, with the *.tftest.hcl files in it or in its tests/.
run = '''
modules="$(git ls-files -- '*.tftest.hcl' | sed 's#[^/]*$##; s#/$##; s#/tests$##; s#^tests$##; s#^$#.#' | sort -u)"
[ -n "$modules" ] || { echo "test:fast: no Terraform tests (*.tftest.hcl)"; exit 0; }
for dir in $modules; do
  echo "== $dir"
  TF_DATA_DIR=.terraform/offline terraform -chdir="$dir" init -backend=false -input=false >/dev/null || exit 1
  TF_DATA_DIR=.terraform/offline terraform -chdir="$dir" test || exit 1
done
'''

[tasks."test:unit"]
description = "Runs test:fast: this project has one test tier."
depends = ["test:fast"]

[tasks."test:changed"]
description = "Runs test:fast: this project has no per-change test selection."
depends = ["test:fast"]

[tasks."check:unit"]
description = "Runs test:unit in a host gate slot (scripts/gate-slot); Terraform measures no coverage."
# The outer mise run already provided the tools.
run = "scripts/gate-slot mise run --skip-tools test:unit"

[tasks."setup:dev"]
alias = "bootstrap"
description = "Installs the git hooks on a fresh checkout."
run = "pre-commit install --install-hooks"

{% if include_fnox -%}
# Provider credentials come from the fnox profile "infra" (see fnox.toml), so a coding
# agent launched with the default profile never holds cloud tokens.
[tasks.plan]
description = "Show the plan of one root module without applying."
usage = 'arg "[dir]" help="the root module directory" default="."'
run = '''fnox exec -P infra --if-missing error -- sh -c 'terraform -chdir="$0" init -input=false && terraform -chdir="$0" plan' "${usage_dir}"'''

[tasks.apply]
description = "Apply the plan of one root module."
usage = 'arg "[dir]" help="the root module directory" default="."'
run = '''fnox exec -P infra --if-missing error -- sh -c 'terraform -chdir="$0" init -input=false && terraform -chdir="$0" apply' "${usage_dir}"'''
{% else -%}
[tasks.plan]
description = "Show the plan of one root module without applying."
usage = 'arg "[dir]" help="the root module directory" default="."'
run = 'terraform -chdir="${usage_dir}" init -input=false && terraform -chdir="${usage_dir}" plan'

[tasks.apply]
description = "Apply the plan of one root module."
usage = 'arg "[dir]" help="the root module directory" default="."'
run = 'terraform -chdir="${usage_dir}" init -input=false && terraform -chdir="${usage_dir}" apply'
{% endif -%}
