{% include "templates/_base/_ci_header.yml.jinja" %}
jobs:
{% if include_mise -%}
{#- The gate script needs Xcode, so the parts run on macOS; plan and check stay on Ubuntu. #}
{% set part_runner = "macos-latest" -%}
{% include "templates/_base/_ci_jobs.yml.jinja" -%}
{% else %}
  build:
    # A draft runs nothing until ready_for_review; a push or a queue entry has no PR, so it always runs.
    if: {% raw %}${{ {% endraw %}{{ repository_guard }}{% raw %}!github.event.pull_request.draft }}{% endraw %}
    runs-on: macos-latest # the gate script needs Xcode
    steps:
{% include "templates/_base/_ci_steps.yml.jinja" %}      - name: Gate script
        run: ./{{ gate_script }}
{% endif -%}
