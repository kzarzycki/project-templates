./gradlew build test
{% include "templates/_base/_diff_base.part" %}if git rev-parse -q --verify "$base^{commit}" >/dev/null; then
  report=build/reports/jacoco/test/jacocoTestReport.xml
  [ -f "$report" ] || report=target/site/jacoco/jacoco.xml
  pipx run diff-cover "$report" --compare-branch="$base" --fail-under=100
fi
