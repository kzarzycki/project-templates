{% if include_mise -%}
```bash
mise install                  # the pinned tools
mise run setup:dev            # install dependencies and the git hooks
mise run check                # lint + unit tests, as CI runs them
```
{% else -%}
```bash
./gradlew build               # compile + run checks
uv tool install pre-commit    # if not already installed
pre-commit install            # enable git hooks
./gradlew test                # run tests
```
{% endif -%}
