[tasks."lint:spotless"]
description = "Checks the Java formatting with Spotless (google-java-format); ./gradlew spotlessApply fixes it."
# Spotless checks the whole project from its Gradle config, so the hook passes it no files.
run = "./gradlew spotlessCheck"

[tasks."test:fast"]
alias = "test"
description = "Runs the fast tier: every JUnit test."
run = "./gradlew test"

[tasks."test:unit"]
description = "Runs every test but the Docker, live and cloud tiers: the fast tier plus slow."
# ponytail: the template has one tier, so this is test:fast's selection; exclude a JUnit tag in test:fast once one is split off.
run = "./gradlew test"

[tasks."test:changed"]
description = "Runs the tests; Gradle skips them when nothing they read changed since the last run."
run = "./gradlew test"

[tasks."check:unit"]
description = "Runs test:unit with coverage (JaCoCo), then fails on any changed line not covered (diff-cover)."
run = '''
mise run --skip-tools test:unit
{% include "templates/_base/_diff_base.part" %}if git rev-parse -q --verify "$base^{commit}" >/dev/null; then
  report=build/reports/jacoco/test/jacocoTestReport.xml
  [ -f "$report" ] || report=target/site/jacoco/jacoco.xml
  diff-cover "$report" --compare-branch="$base" --fail-under=100
fi
'''

[tasks."setup:dev"]
alias = "bootstrap"
description = "Installs the dependencies and the git hooks on a fresh checkout."
run = "./gradlew classes testClasses && pre-commit install --install-hooks"
