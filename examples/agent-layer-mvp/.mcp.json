{
  "mcpServers": {
    "agent-layer-canary": {
      "type": "stdio",
      "command": "fnox",
      "args": [
        "exec",
        "--profile",
        "local",
        "--no-defaults",
        "--non-interactive",
        "--if-missing",
        "error",
        "--",
        "uv",
        "run",
        "python",
        "scripts/mcp_canary.py"
      ]
    }
  }
}
